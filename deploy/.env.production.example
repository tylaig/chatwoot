# ==========================================
# CHATWOOT PRODUÇÃO - VARIÁVEIS DE AMBIENTE
# ==========================================

# 1. Chaves de Segurança Rails (Obrigatório)
# Gere uma string hex de 128 caracteres (ex: python3 -c "import secrets; print(secrets.token_hex(64))")
SECRET_KEY_BASE=SEU_SECRET_KEY_BASE_AQUI

# Chaves de Criptografia do Active Record (necessário para 2FA e credenciais)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=5mqPbqDG9o5VHXAX83KY08dCG8slcfH4i6flmAMHFdA=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=/5LEO0IXBSE4hesXJbzpsLFVbwPMdd3ssCKf05qPpLg=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=xMKTfasSyccpZPu7LluuOz4fBJiJXuGEmL72YwlVu8U=

# 2. URLs da Aplicação
# Coloque seu domínio público real (com https://)
FRONTEND_URL=https://chat.seudominio.com
FORCE_SSL=true

# Permitir criar a primeira conta de administrador
ENABLE_ACCOUNT_SIGNUP=false

# 3. Banco de Dados PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI
POSTGRES_STATEMENT_TIMEOUT=14s

# 4. Redis
REDIS_URL=redis://:DEFINA_SENHA_REDIS_AQUI@redis:6379
REDIS_PASSWORD=DEFINA_SENHA_REDIS_AQUI

# 5. Configurações Rails / Performance
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# 6. E-mail Transacional (SMTP)
MAILER_SENDER_EMAIL=Atendimento <nao-responda@seudominio.com>
SMTP_DOMAIN=seudominio.com
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SUA_API_KEY_SMTP
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
