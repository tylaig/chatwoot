<% content_for(:title) { page.page_title.to_s } %>

<header class="main-content__header" role="banner">
  <div>
    <p class="msc-sa-eyebrow">Usuário · ID <%= page.resource.id %></p>
    <h1 class="main-content__page-title" id="page-title"><%= content_for(:title) %></h1>
  </div>
  <div class="msc-sa-header-actions">
    <%= link_to '← Usuários', super_admin_users_path, class: 'msc-btn-ghost' %>
    <%= button_to("Reenviar confirmação", [:resend_confirmation, namespace, page.resource.becomes(User)],
          method: :post, class: "msc-btn-ghost", form_class: "button_to") unless page.resource.confirmed? %>
    <%= link_to("Editar usuário", [:edit, namespace, page.resource.becomes(User)], class: "button") if authorized_action? page.resource, :edit %>
  </div>
</header>

<section class="main-content__body">
  <% page.attributes.each do |title, attributes| %>
    <fieldset class="<%= "field-unit--nested" if title.present? %>">
      <legend><%= title.present? ? t("helpers.label.#{page.resource_name}.#{title}", default: title.to_s.humanize) : 'Dados do usuário' %></legend>
      <dl class="msc-attrs">
        <% attributes.each do |attribute| %>
          <div class="msc-attr-row">
            <dt class="attribute-label" id="<%= attribute.name %>"><%= t("helpers.label.#{resource_name}.#{attribute.name}", default: page.resource.class.human_attribute_name(attribute.name)) %></dt>
            <dd class="attribute-data attribute-data--<%= attribute.html_class %>"><%= render_field attribute, page: page %></dd>
          </div>
        <% end %>
        <% if title.blank? %>
          <div class="msc-attr-row">
            <dt class="attribute-label" id="mfa_enabled">MFA</dt>
            <dd class="attribute-data"><% mfa = page.resource.mfa_enabled? %><span class="msc-badge <%= mfa ? 'msc-badge--ok' : 'msc-badge--off' %>"><%= mfa ? 'Ativado' : 'Desativado' %></span></dd>
          </div>
        <% end %>
      </dl>
    </fieldset>
  <% end %>
</section>

<%= render 'super_admin/shared/account_user_form', page: page, namespace: namespace, resource_type: 'user' %>
<%= render partial: "impersonate", locals: { page: page } %>
