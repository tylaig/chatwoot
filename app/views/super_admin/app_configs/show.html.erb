<%
  wl_cfg = defined?(EliteLicenseEngine) ? EliteLicenseEngine.whitelabel_config : {}
  inst_brand = wl_cfg['INSTALLATION_NAME'].presence || wl_cfg['BRAND_NAME'].presence || 'Meu Super Chat'
  config_name = begin
    settings_pages.to_h.values.find { |a| a['config_key'] == @config }&.dig('name')
  rescue StandardError
    nil
  end
  config_name ||= (@config == 'custom_branding' ? 'Identidade Visual White-Label' : @config.to_s.titleize)
%>
<% content_for(:title) { "Configurações · #{config_name}" } %>

<header class="main-content__header" role="banner">
  <div>
    <p class="msc-sa-eyebrow">Super Admin · Governança White-Label & Configurações</p>
    <h1 class="main-content__page-title" id="page-title"><%= config_name %></h1>
    <p class="msc-sa-subtitle">Parâmetros globais aplicados a todas as contas desta instância (<%= inst_brand %>).</p>
  </div>
  <div class="msc-sa-header-actions">
    <% if @config == 'custom_branding' %>
      <%= link_to '✨ Abrir White-Label Studio Live', "#{super_admin_settings_path}#whitelabel-studio", class: 'button' %>
    <% end %>
    <%= link_to '← Licenças & Studio', super_admin_settings_path, class: 'msc-btn-ghost' %>
  </div>
</header>

<section class="main-content__body">
  <% if @config == 'custom_branding' && defined?(EliteLicenseEngine) %>
    <div class="msc-card msc-card--accent" style="margin-bottom:16px;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <div style="font-size:13px;font-weight:700;color:#F8FAFC;display:flex;align-items:center;gap:8px;">
          <span style="display:inline-block;width:8px;height:8px;border-radius:999px;background:#00FFA3;box-shadow:0 0 8px #00FFA3;"></span>
          Presets Rápidos de Marca (EliteLicenseEngine)
        </div>
        <p style="margin:4px 0 0;font-size:12px;color:#94A3B8;">Aplique com 1 clique os presets oficiais ou personalize cada chave abaixo.</p>
      </div>
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <%= button_to 'Aplicar Preset: Meu Super Chat (SaaS)', apply_preset_super_admin_settings_path(preset: 'meusuperchat'), method: :post, class: 'msc-btn-ghost', style: 'font-size:12px;padding:7px 12px;cursor:pointer;' %>
        <%= button_to 'Aplicar Preset: Games Safari (White-Label)', apply_preset_super_admin_settings_path(preset: 'gamessafari'), method: :post, class: 'msc-btn-ghost', style: 'font-size:12px;padding:7px 12px;cursor:pointer;' %>
      </div>
    </div>
  <% end %>
  <%= form_with url: super_admin_app_config_path(config: @config), method: :post, class: 'msc-card', style: 'padding:6px 22px 22px;' do |form| %>
    <% if @allowed_configs.empty? %>
      <p class="msc-muted" style="padding:16px 0;">Nenhuma configuração disponível para este módulo.</p>
    <% end %>
    <% @allowed_configs.each do |key| %>
      <% meta = @installation_configs[key] || {} %>
      <% label = meta['display_title'].presence || key.humanize %>
      <div class="field-unit">
        <div class="field-unit__label">
          <%= form.label "app_config[#{key}]", label, for: "app_config_#{key}" %>
          <div class="msc-mono" style="font-size:10.5px;color:#475569;margin-top:4px;font-weight:500;"><%= key %></div>
        </div>
        <div class="field-unit__field">
          <% case meta['type'] %>
          <% when 'boolean' %>
            <%= form.select "app_config[#{key}]", [["Ativado", true], ["Desativado", false]],
                  { selected: ActiveModel::Type::Boolean.new.cast(@app_config[key]) }, id: "app_config_#{key}" %>
          <% when 'code' %>
            <%= form.text_area "app_config[#{key}]", value: @app_config[key], rows: 10, wrap: 'off', id: "app_config_#{key}", class: 'msc-mono' %>
          <% when 'secret' %>
            <div class="msc-secret-input">
              <%= form.password_field "app_config[#{key}]", id: "app_config_#{key}", value: @app_config[key], autocomplete: 'off' %>
              <button type="button" class="msc-icon-btn toggle-password" data-target="app_config_<%= key %>" aria-label="Mostrar/ocultar valor">
                <svg class="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5C5.63636 5 2 12 2 12C2 12 5.63636 19 12 19C18.3636 19 22 12 22 12C22 12 18.3636 5 12 5Z"/>
                  <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"/>
                </svg>
              </button>
            </div>
          <% when 'select' %>
            <% if meta['options'].present? %>
              <%= form.select "app_config[#{key}]", meta['options'].map { |val, lbl| [lbl, val] }, { selected: @app_config[key] }, id: "app_config_#{key}" %>
            <% else %>
              <%= form.text_field "app_config[#{key}]", value: @app_config[key], id: "app_config_#{key}" %>
            <% end %>
          <% else %>
            <% if key == 'BRAND_COLOR' %>
              <div style="display:flex;align-items:center;gap:10px;">
                <input type="color" value="<%= @app_config[key].presence || '#10B981' %>" onchange="document.getElementById('app_config_BRAND_COLOR').value = this.value.toUpperCase()" style="width:42px;height:38px;padding:2px;border-radius:8px;border:1px solid #16262E;background:#070D12;cursor:pointer;" aria-label="Seletor de cor da marca" />
                <%= form.text_field "app_config[#{key}]", value: @app_config[key].presence || '#10B981', id: "app_config_#{key}", class: 'msc-mono', style: 'flex:1;' %>
              </div>
            <% else %>
              <%= form.text_field "app_config[#{key}]", value: @app_config[key], id: "app_config_#{key}" %>
            <% end %>
          <% end %>
          <% if meta['description'].present? %>
            <p style="margin:8px 0 0;font-size:12.5px;color:#94A3B8;line-height:1.5;"><%= meta['description'].to_s.gsub(/Chatwoot/i, inst_brand) %></p>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @allowed_configs.any? %>
      <div class="form-actions" style="padding-top:6px !important;">
        <%= form.submit "Salvar configurações" %>
        <%= link_to 'Cancelar', super_admin_settings_path, class: 'msc-btn-ghost' %>
      </div>
    <% end %>
  <% end %>
</section>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.toggle-password').forEach(function (button) {
      button.addEventListener('click', function () {
        var input = document.getElementById(button.dataset.target);
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
        button.classList.toggle('is-on', input.type === 'text');
      });
    });
  });
  </script>
<% end %>
