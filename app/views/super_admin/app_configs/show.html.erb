<%
  config_name = begin
    settings_pages.to_h.values.find { |a| a['config_key'] == @config }&.dig('name')
  rescue StandardError
    nil
  end
  config_name ||= @config.to_s.titleize
%>
<% content_for(:title) { "Configurações · #{config_name}" } %>

<header class="main-content__header" role="banner">
  <div>
    <p class="msc-sa-eyebrow">Super Admin · Configurações</p>
    <h1 class="main-content__page-title" id="page-title"><%= config_name %></h1>
    <p class="msc-sa-subtitle">Parâmetros globais aplicados a todas as contas desta instância do Meu Super Chat.</p>
  </div>
  <div class="msc-sa-header-actions">
    <%= link_to '← Todas as configurações', super_admin_settings_path, class: 'msc-btn-ghost' %>
  </div>
</header>

<section class="main-content__body">
  <%= form_with url: super_admin_app_config_path(config: @config), method: :post, class: 'msc-card', style: 'padding:6px 22px 22px;' do |form| %>
    <% if @allowed_configs.empty? %>
      <p class="msc-muted" style="padding:16px 0;">Nenhuma configuração disponível para este módulo.</p>
    <% end %>
    <% @allowed_configs.each do |key| %>
      <% meta = @installation_configs[key] || {} %>
      <% label = meta['display_title'].presence || key.humanize %>
      <div class="field-unit">
        <div class="field-unit__label">
          <%= form.label "app_config[#{key}]", label, for: "app_config_#{key}" %>
          <div class="msc-mono" style="font-size:10.5px;color:#475569;margin-top:4px;font-weight:500;"><%= key %></div>
        </div>
        <div class="field-unit__field">
          <% case meta['type'] %>
          <% when 'boolean' %>
            <%= form.select "app_config[#{key}]", [["Ativado", true], ["Desativado", false]],
                  { selected: ActiveModel::Type::Boolean.new.cast(@app_config[key]) }, id: "app_config_#{key}" %>
          <% when 'code' %>
            <%= form.text_area "app_config[#{key}]", value: @app_config[key], rows: 10, wrap: 'off', id: "app_config_#{key}", class: 'msc-mono' %>
          <% when 'secret' %>
            <div class="msc-secret-input">
              <%= form.password_field "app_config[#{key}]", id: "app_config_#{key}", value: @app_config[key], autocomplete: 'off' %>
              <button type="button" class="msc-icon-btn toggle-password" data-target="app_config_<%= key %>" aria-label="Mostrar/ocultar valor">
                <svg class="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5C5.63636 5 2 12 2 12C2 12 5.63636 19 12 19C18.3636 19 22 12 22 12C22 12 18.3636 5 12 5Z"/>
                  <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"/>
                </svg>
              </button>
            </div>
          <% when 'select' %>
            <% if meta['options'].present? %>
              <%= form.select "app_config[#{key}]", meta['options'].map { |val, lbl| [lbl, val] }, { selected: @app_config[key] }, id: "app_config_#{key}" %>
            <% else %>
              <%= form.text_field "app_config[#{key}]", value: @app_config[key], id: "app_config_#{key}" %>
            <% end %>
          <% else %>
            <%= form.text_field "app_config[#{key}]", value: @app_config[key], id: "app_config_#{key}" %>
          <% end %>
          <% if meta['description'].present? %>
            <p style="margin:8px 0 0;font-size:12.5px;color:#94A3B8;line-height:1.5;"><%= meta['description'].to_s.gsub(/Chatwoot/i, 'Meu Super Chat') %></p>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @allowed_configs.any? %>
      <div class="form-actions" style="padding-top:6px !important;">
        <%= form.submit "Salvar configurações" %>
        <%= link_to 'Cancelar', super_admin_settings_path, class: 'msc-btn-ghost' %>
      </div>
    <% end %>
  <% end %>
</section>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.toggle-password').forEach(function (button) {
      button.addEventListener('click', function () {
        var input = document.getElementById(button.dataset.target);
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
        button.classList.toggle('is-on', input.type === 'text');
      });
    });
  });
  </script>
<% end %>
