<%
  wl_pd = defined?(EliteLicenseEngine) ? EliteLicenseEngine.whitelabel_config : {}
  pd_brand = wl_pd['INSTALLATION_NAME'].presence || wl_pd['BRAND_NAME'].presence || 'Meu Super Chat'
%>
<% content_for(:title) { "Diagnóstico de Push" } %>

<header class="main-content__header" role="banner">
  <div>
    <p class="msc-sa-eyebrow">Super Admin · Infraestrutura</p>
    <h1 class="main-content__page-title" id="page-title">Diagnóstico de Push</h1>
    <p class="msc-sa-subtitle">Envie um push de teste para os dispositivos de um usuário e veja a resposta bruta do FCM / Web Push / relay.</p>
  </div>
</header>

<section class="main-content__body">
  <div class="msc-card" style="margin-bottom:18px;">
    <h2 class="msc-card__title">1. Localizar usuário</h2>
    <%= form_with url: super_admin_push_diagnostics_path, method: :get, local: true, class: 'msc-inline-form' do |f| %>
      <label for="user_query" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">E-mail ou ID do usuário</label>
      <%= f.text_field :user_query, value: @query, id: 'user_query', placeholder: 'usuario@empresa.com ou ID numérico' %>
      <%= f.submit 'Buscar' %>
    <% end %>
    <% if @query.present? && @user.nil? %>
      <div class="msc-alert msc-alert--err" style="margin:12px 0 0;">Nenhum usuário encontrado para "<%= @query %>".</div>
    <% end %>
  </div>

  <% if @user %>
    <div class="msc-card msc-card--accent" style="margin-bottom:18px;">
      <div class="msc-list__main">
        <span class="msc-avatar"><%= @user.name.to_s.first.to_s.upcase %></span>
        <div style="min-width:0;">
          <div style="font-weight:700;color:#F8FAFC;"><%= @user.name %></div>
          <div class="msc-list__meta" style="word-break:break-all;"><%= @user.email %> · ID <%= @user.id %></div>
        </div>
      </div>
      <% if @user.accounts.any? %>
        <p class="msc-card__desc" style="margin-top:10px !important;">Contas:
          <% @user.accounts.each_with_index do |account, index| %><%= ', ' if index.positive? %><%= account.name %> (ID <%= account.id %>)<% end %>
        </p>
      <% end %>
    </div>

    <div class="msc-card" style="margin-bottom:18px;">
      <h2 class="msc-card__title">2. Selecionar inscrições (<%= @subscriptions.count %>)</h2>
      <div class="msc-alert msc-alert--warn" style="margin:12px 0;">⚠️ Isto envia um push real para cada dispositivo selecionado. Use apenas para diagnosticar problemas reportados.</div>

      <% if @subscriptions.empty? %>
        <p class="msc-muted">Este usuário não possui inscrições de push registradas.</p>
      <% else %>
        <%= form_with url: super_admin_push_diagnostics_path, method: :post, local: true do |f| %>
          <%= f.hidden_field :user_id, value: @user.id %>
          <div style="display:grid;gap:12px;max-width:720px;margin-bottom:16px;">
            <div>
              <%= label_tag :push_title, 'Título', style: 'display:block;margin-bottom:6px;' %>
              <%= text_field_tag :push_title, params[:push_title].presence || Notification::PushTestService.default_title.to_s.gsub(/Chatwoot/i, pd_brand) %>
            </div>
            <div>
              <%= label_tag :push_body, 'Mensagem', style: 'display:block;margin-bottom:6px;' %>
              <%= text_area_tag :push_body, params[:push_body].presence || Notification::PushTestService.default_body.to_s.gsub(/Chatwoot/i, pd_brand), rows: 2 %>
            </div>
            <p class="msc-muted" style="font-size:12px;margin:0;">O usuário verá este texto como uma notificação real no dispositivo.</p>
          </div>
          <div class="msc-table-scroll">
            <table>
              <thead>
                <tr>
                  <th><input type="checkbox" id="toggle-all" aria-label="Selecionar todas"></th>
                  <th>ID</th><th>Tipo</th><th>Dispositivo / endpoint</th><th>Token</th><th>Detalhes</th><th>Criado</th><th>Atualizado</th>
                </tr>
              </thead>
              <tbody>
                <% @subscriptions.each do |sub| %>
                  <% attrs = (sub.subscription_attributes || {}).stringify_keys %>
                  <% if sub.browser_push? %>
                    <% endpoint = attrs['endpoint'].to_s %>
                    <% host = (begin; URI.parse(endpoint).host; rescue URI::InvalidURIError; nil; end) %>
                    <% device_display = host.presence || endpoint.presence || '—' %>
                    <% token_display = endpoint.present? ? "…#{endpoint.last(6)}" : '—' %>
                  <% else %>
                    <% device_display = attrs['device_id'].present? ? "…#{attrs['device_id'].to_s.last(6)}" : '—' %>
                    <% token_display = attrs['push_token'].present? ? "…#{attrs['push_token'].to_s.last(6)}" : '—' %>
                  <% end %>
                  <% extra_attrs = attrs.except('endpoint', 'p256dh', 'auth', 'push_token', 'device_id') %>
                  <tr>
                    <td><%= check_box_tag 'subscription_ids[]', sub.id, false, class: 'subscription-checkbox', 'aria-label': "Inscrição #{sub.id}" %></td>
                    <td><%= sub.id %></td>
                    <td><%= sub.subscription_type %></td>
                    <td class="msc-mono"><%= device_display %></td>
                    <td class="msc-mono"><%= token_display %></td>
                    <td style="font-size:12px !important;">
                      <% if extra_attrs.present? %>
                        <% extra_attrs.each do |k, v| %><div><span class="msc-muted"><%= k %>:</span> <span class="msc-mono"><%= v.to_s.truncate(40) %></span></div><% end %>
                      <% else %><span class="msc-muted">—</span><% end %>
                    </td>
                    <td style="white-space:nowrap;"><%= sub.created_at.strftime('%d/%m/%Y %H:%M') %></td>
                    <td style="white-space:nowrap;"><%= sub.updated_at.strftime('%d/%m/%Y %H:%M') %> <span class="msc-muted" style="font-size:11px;">(há <%= time_ago_in_words(sub.updated_at) %>)</span></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="form-actions" style="margin-top:16px !important;">
            <%= f.submit 'Enviar push de teste' %>
            <%= submit_tag 'Excluir inscrições selecionadas',
                  formaction: destroy_subscriptions_super_admin_push_diagnostics_path, formmethod: 'post',
                  data: { confirm: "Excluir as inscrições selecionadas? O usuário não receberá pushes nesses dispositivos até o app se registrar novamente." },
                  class: 'msc-btn-danger' %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @results.present? %>
      <div class="msc-card">
        <h2 class="msc-card__title" style="margin-bottom:12px !important;">3. Resultados</h2>
        <div class="msc-table-scroll">
          <table>
            <thead><tr><th>Inscrição</th><th>Tipo</th><th>Dispositivo</th><th>Token</th><th>Status</th><th>Detalhes</th></tr></thead>
            <tbody>
              <% @results.each do |r| %>
                <tr>
                  <td><%= r[:id] %></td>
                  <td><%= r[:type] %></td>
                  <td class="msc-mono"><%= r[:device] %></td>
                  <td class="msc-mono"><%= r[:token_tail] %></td>
                  <td><span class="msc-badge <%= { success: 'msc-badge--ok', failure: 'msc-badge--err', skipped: 'msc-badge--off' }[r[:status]] %>"><%= { success: 'sucesso', failure: 'falha', skipped: 'ignorado' }[r[:status]] || r[:status] %></span></td>
                  <td class="msc-mono" style="white-space:pre-wrap;"><%= r[:message] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% end %>
</section>

<% content_for :javascript do %>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var toggle = document.getElementById('toggle-all');
      if (!toggle) return;
      toggle.addEventListener('change', function (e) {
        document.querySelectorAll('.subscription-checkbox').forEach(function (cb) { cb.checked = e.target.checked; });
      });
    });
  </script>
<% end %>
