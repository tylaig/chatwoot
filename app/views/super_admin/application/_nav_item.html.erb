<%
  active = begin
    current_page?(url) || (url.to_s == super_admin_root_path && request.path.in?(['/super_admin', '/super_admin/', '/super_admin/dashboard'])) ||
      (url.to_s.start_with?('/super_admin/') && url.to_s.length > '/super_admin/'.length && request.path.start_with?(url.to_s))
  rescue StandardError
    false
  end
%>
<li>
  <%= link_to(url, class: "msc-sa-nav__link#{' is-active' if active}", 'aria-current': (active ? 'page' : nil)) do %>
    <svg aria-hidden="true"><use xlink:href="#<%= icon %>" /></svg>
    <span><%= label %></span>
  <% end %>
</li>
