<% content_for(:title) do %><%= display_resource_name(page.resource_name) %><% end %>

<header class="main-content__header" role="banner">
  <div>
    <p class="msc-sa-eyebrow">Super Admin · Governança</p>
    <h1 class="main-content__page-title" id="page-title"><%= content_for(:title) %></h1>
  </div>
  <div class="msc-sa-header-actions">
    <% if show_search_bar %>
      <%= render("filters", page: page) %>
      <%= render("search", search_term: search_term, resource_name: display_resource_name(page.resource_name)) %>
    <% end %>
    <%= link_to("+ Novo registro", [:new, namespace, page.resource_path.to_sym], class: "button") if accessible_action?(new_resource, :new) %>
  </div>
</header>

<section class="main-content__body main-content__body--flush">
  <%= render("collection", collection_presenter: page, collection_field_name: resource_name, page: page, resources: resources, table_title: "page-title") %>
  <%= paginate resources, param_name: '_page' %>
</section>
