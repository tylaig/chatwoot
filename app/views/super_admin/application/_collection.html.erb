<% user_mode = local_assigns.fetch(:user_mode, false) %>
<div class="msc-table-scroll">
  <table aria-labelledby="<%= table_title %>">
    <thead>
      <tr>
        <% collection_presenter.attribute_types.each do |attr_name, attr_type| %>
          <th class="cell-label cell-label--<%= attr_type.html_class %> cell-label--<%= collection_presenter.ordered_html_class(attr_name) %>"
              scope="col" role="columnheader"
              aria-sort="<%= sort_order(collection_presenter.ordered_html_class(attr_name)) %>">
            <%= link_to(sanitized_order_params(page, collection_field_name).merge(
                  collection_presenter.order_params_for(attr_name, key: collection_field_name))) do %>
              <%= t("helpers.label.#{collection_presenter.resource_name}.#{attr_name}", default: attr_name.to_s).titleize %>
              <% if collection_presenter.ordered_by?(attr_name) %>
                <span class="cell-label__sort-indicator cell-label__sort-indicator--<%= collection_presenter.ordered_html_class(attr_name) %>">
                  <svg aria-hidden="true"><use xlink:href="#icon-up-caret" /></svg>
                </span>
              <% end %>
            <% end %>
          </th>
        <% end %>
        <% [existing_action?(collection_presenter.resource_name, :edit),
            existing_action?(collection_presenter.resource_name, :destroy)].count(true).times do %>
          <th scope="col" aria-label="Ações"></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% if resources.respond_to?(:empty?) && resources.empty? %>
        <tr><td colspan="99" style="text-align:center;padding:36px 16px !important;color:#94A3B8 !important;">Nenhum registro encontrado.</td></tr>
      <% end %>
      <% resources.each do |resource| %>
        <% target = user_mode ? resource.becomes(User) : resource %>
        <tr class="js-table-row" tabindex="0"
            <% if existing_action? collection_presenter.resource_name, :show %>
              <%= %(role=link data-url=#{polymorphic_path([namespace, target])}) %>
            <% end %>>
          <% collection_presenter.attributes_for(resource).each do |attribute| %>
            <td class="cell-data cell-data--<%= attribute.html_class %>">
              <% if authorized_action? resource, :show -%>
                <a href="<%= polymorphic_path([namespace, target]) -%>" class="action-show"><%= render_field attribute %></a>
              <% else %>
                <%= render_field attribute %>
              <% end -%>
            </td>
          <% end %>
          <% if existing_action? collection_presenter.resource_name, :edit %>
            <td style="width:1%;"><%= link_to("Editar", [:edit, namespace, target], class: "action-edit") if authorized_action? resource, :edit %></td>
          <% end %>
          <% if existing_action? collection_presenter.resource_name, :destroy %>
            <td style="width:1%;"><%= link_to("Excluir",
                  [namespace, (user_mode && collection_presenter.resource_name != 'account_user') ? target : resource],
                  class: "text-color-red", method: :delete,
                  data: { confirm: "Tem certeza que deseja excluir este registro? Esta ação não pode ser desfeita." }) if authorized_action? resource, :destroy %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
