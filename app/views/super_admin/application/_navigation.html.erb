<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>
<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
  }
  resource_labels = {
    'accounts' => 'Contas',
    'users' => 'Usuários',
    'platform_apps' => 'Apps da Plataforma',
    'agent_bots' => 'Agent Bots',
  }
  hidden_resources = %w[platform_banners account_users access_tokens installation_configs dashboard devise/sessions app_configs instance_statuses settings push_diagnostics]
%>
<aside id="msc-sa-sidebar" class="msc-sa-sidebar" role="navigation" aria-label="Navegação do Super Admin">
  <div>
    <div class="msc-sa-sidebar__brand">
      <a href="<%= super_admin_root_path %>">
        <span class="msc-sa-sidebar__logo"><svg aria-hidden="true"><use xlink:href="#icon-bolt-fill" /></svg></span>
        <span class="msc-sa-sidebar__name">
          <strong>Meu Super <em>Chat</em></strong>
          <small>Super Admin · v<%= Chatwoot.config[:version] %></small>
        </span>
      </a>
      <button type="button" class="msc-sa-sidebar__close" aria-label="Fechar menu" onclick="document.body.classList.remove('msc-sa-drawer-open')">✕</button>
      <button type="button" class="msc-sa-sidebar__collapse" aria-label="Recolher navegação" aria-controls="msc-sa-sidebar" aria-expanded="true" title="Recolher navegação" onclick="window.mscToggleSidebar && mscToggleSidebar()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/><path d="M19 5v14"/></svg>
      </button>
    </div>

    <div class="msc-sa-section">Governança</div>
    <ul class="msc-sa-nav">
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_path, label: 'Visão Geral' } %>
      <% Administrate::Namespace.new(namespace).resources.each do |resource| %>
        <% next if hidden_resources.include?(resource.resource) %>
        <%= render partial: "nav_item", locals: {
              icon: sidebar_icons[resource.resource.to_sym] || 'icon-grid-line',
              url: resource_index_route(resource),
              label: resource_labels[resource.resource] || display_resource_name(resource),
            } %>
      <% end %>
      <%= render 'settings_menu', open: settings_open? %>
    </ul>
  </div>

  <div class="msc-sa-sidebar__foot">
    <div class="msc-sa-sidebar__theme"><span>Tema da interface</span><%= render "super_admin/application/theme_toggle" %></div>
    <div class="msc-sa-section">Infraestrutura</div>
    <ul class="msc-sa-nav">
      <%= render partial: "nav_item", locals: { icon: 'icon-refresh-line', url: "#{super_admin_instance_status_path}?open_updater=1", label: 'Atualizações (Deploy)' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_path, label: 'Filas Sidekiq' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_path, label: 'Saúde da Instância' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-send-plane-line', url: super_admin_push_diagnostics_path, label: 'Diagnóstico de Push' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: 'Painel de Atendimento' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_path, label: 'Sair' } %>
    </ul>
  </div>
</aside>
