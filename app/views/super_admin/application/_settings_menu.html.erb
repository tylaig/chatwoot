<li>
  <details <%= 'open' if open %>>
    <summary class="msc-sa-nav__link<%= ' is-active' if open %>">
      <svg aria-hidden="true"><use xlink:href="#icon-settings-2-line" /></svg>
      <span>Configurações</span>
      <svg class="msc-sa-nav__chev" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
    </summary>
    <ul class="msc-sa-subnav">
      <li><%= link_to 'Visão geral & recursos', super_admin_settings_path, class: (current_page?(super_admin_settings_path) ? 'is-active' : nil) %></li>
      <% settings_pages.each do |_feature_key, attrs| %>
        <% url = super_admin_app_config_path(config: attrs['config_key']) %>
        <% sub_active = request.path == super_admin_app_config_path && (params[:config].presence || 'general') == attrs['config_key'] %>
        <li><%= link_to attrs['name'], url, class: (sub_active ? 'is-active' : nil) %></li>
      <% end %>
    </ul>
  </details>
</li>
