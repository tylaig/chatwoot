<% content_for(:title) { "Configurações" } %>
<header class="main-content__header" role="banner">
  <div>
    <p class="msc-sa-eyebrow">Super Admin · Instância</p>
    <h1 class="main-content__page-title" id="page-title">Configurações da Instância</h1>
    <p class="msc-sa-subtitle">Licenciamento, identificação da instalação e módulos disponíveis no Meu Super Chat.</p>
  </div>
  <div class="msc-sa-header-actions">
    <%= link_to 'Configurações gerais', super_admin_app_config_path(config: 'general'), class: 'button' %>
  </div>
</header>

<section class="main-content__body">
  <% if Redis::Alfred.get(Redis::Alfred::CHATWOOT_INSTALLATION_CONFIG_RESET_WARNING) %>
    <div class="msc-alert msc-alert--err" role="alert">
      <strong>Atenção:</strong> foram detectadas alterações em recursos premium sem licença válida. Para mantê-las ativas, regularize o plano junto ao suporte do Meu Super Chat
      (<a href="mailto:contato@meusuper.app" style="color:#FCA5A5;text-decoration:underline;">contato@meusuper.app</a>).
    </div>
  <% end %>

  <%= javascript_include_tag "secretField" %>

  <div class="msc-grid msc-grid--wide">
    <div class="msc-card">
      <h2 class="msc-card__title">Identificador da instalação</h2>
      <p class="msc-card__desc">Chave única desta instância. Mantenha em sigilo.</p>
      <div data-secret-text="<%= ChatwootHub.installation_identifier %>" class="cell-data__secret-field msc-secret">
        <span data-secret-masked="true" class="select-none msc-mono"></span>
        <button type="button" onclick="toggleSecretField(event)" data-secret-toggler class="msc-icon-btn" aria-label="Mostrar/ocultar identificador">
          <svg width="18" height="18" class="fill-current"><use xlink:href="#eye-show" /></svg>
        </button>
        <button type="button" onclick="copySecretField(event)" data-secret-copier class="msc-icon-btn" aria-label="Copiar identificador">
          <svg width="18" height="18" class="fill-current"><use xlink:href="#icon-copy" /></svg>
        </button>
      </div>
    </div>

    <% if ChatwootApp.enterprise? %>
      <div class="msc-card msc-card--accent">
        <div class="msc-row">
          <h2 class="msc-card__title">Plano atual</h2>
          <a href="<%= refresh_super_admin_settings_path %>" class="msc-link">
            <svg width="14" height="14" style="vertical-align:-2px;fill:currentColor;"><use xlink:href="#icon-refresh-line" /></svg> Atualizar
          </a>
        </div>
        <p class="msc-card__desc" style="font-size:13.5px;"><%= SuperAdmin::FeaturesHelper.plan_details.html_safe %></p>
        <% if ChatwootHub.pricing_plan != 'community' && User.count > ChatwootHub.pricing_plan_quantity.to_i && ChatwootHub.pricing_plan_quantity.to_i.positive? %>
          <div class="msc-alert msc-alert--warn" style="margin:12px 0 0;">Existem <%= User.count %> usuários cadastrados — acima do número de licenças contratadas.</div>
        <% end %>
      </div>
    <% end %>

    <div class="msc-card">
      <h2 class="msc-card__title">Precisa de ajuda?</h2>
      <p class="msc-card__desc">Fale com o time do Meu Super Chat para suporte técnico, licenciamento e onboarding.</p>
      <div class="form-actions" style="margin-top:14px !important;">
        <a href="https://chat.meusuper.app/lp#faq" target="_blank" rel="noopener noreferrer" class="msc-btn-ghost">Central de ajuda ↗</a>
        <a href="mailto:contato@meusuper.app" class="msc-btn-ghost">contato@meusuper.app</a>
      </div>
    </div>
  </div>

  <div class="msc-row" style="margin:30px 0 14px;">
    <div>
      <h2 class="msc-card__title" style="font-size:16px !important;">Recursos & módulos</h2>
      <p class="msc-card__desc">Canais, integrações e recursos enterprise disponíveis nesta instalação.</p>
    </div>
  </div>

  <div class="msc-grid" data-testid="msc-features">
    <% SuperAdmin::FeaturesHelper.available_features.each do |_feature, attrs| %>
      <div class="msc-card msc-feature <%= 'msc-feature--off' unless attrs[:enabled] %>">
        <div class="msc-feature__head">
          <span class="msc-feature__icon"><svg aria-hidden="true"><use xlink:href="#<%= attrs[:icon] %>" /></svg></span>
          <span class="msc-badge <%= attrs[:enabled] ? 'msc-badge--ok' : 'msc-badge--off' %>"><%= attrs[:enabled] ? 'Ativo' : 'Bloqueado' %></span>
        </div>
        <div class="msc-feature__name">
          <%= attrs[:name] %>
          <% if attrs[:enterprise] %><span class="msc-badge msc-badge--warn" style="padding:1px 8px;font-size:10px;">ENTERPRISE</span><% end %>
        </div>
        <p class="msc-feature__desc"><%= attrs[:description] %></p>
        <div class="msc-feature__foot">
          <% if attrs[:config_key].present? && attrs[:enabled] %>
            <%= link_to 'Configurar →', super_admin_app_config_path(config: attrs[:config_key]), class: 'msc-link' %>
          <% elsif !attrs[:enabled] %>
            <span class="msc-muted" style="font-size:12px;">Disponível na edição Enterprise</span>
          <% else %>
            <span class="msc-muted" style="font-size:12px;">Sem configuração adicional</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
