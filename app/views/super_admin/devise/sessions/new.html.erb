<%
  wl = defined?(EliteLicenseEngine) ? EliteLicenseEngine.whitelabel_config : {}
  brand_name = wl['INSTALLATION_NAME'].presence || wl['BRAND_NAME'].presence || 'Meu Super Chat'
  brand_logo = wl['LOGO_THUMBNAIL'].presence || '/brand-assets/logo_thumbnail.svg'
  brand_url = wl['BRAND_URL'].presence || 'https://chat.meusuper.app'
  brand_host = brand_url.sub(%r{\Ahttps?://}, '').sub(%r{/\z}, '')
%>
<!DOCTYPE html>
<html lang="pt-BR" class="dark" style="background:#04090D;">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <title>Entrar • Super Admin | <%= brand_name %></title>
    <link rel="icon" href="<%= brand_logo %>">
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; min-height: 100%; width: 100%; overflow-x: hidden; background: #04090D !important; color: #F8FAFC; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
      .msc-login { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 32px 16px;
        background: radial-gradient(900px 480px at 50% -10%, rgba(16,185,129,.16), transparent 60%), radial-gradient(600px 400px at 100% 100%, rgba(16,185,129,.06), transparent 60%), #04090D; }
      .msc-login__wrap { width: 100%; max-width: 440px; }
      .msc-login__brand { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; margin-bottom: 26px; }
      .msc-login__logo { width: 60px; height: 60px; border-radius: 16px; background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.35); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 40px rgba(16,185,129,.18); }
      .msc-login__logo img { width: 36px; height: 36px; }
      .msc-login__eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #10B981; margin: 0; }
      .msc-login__title { font-size: 1.6rem; font-weight: 800; letter-spacing: -.02em; margin: 0; color: #F8FAFC; }
      .msc-login__sub { margin: 0; font-size: 13.5px; color: #94A3B8; line-height: 1.5; }
      .msc-login__card { background: #081218; border: 1px solid #132631; border-radius: 18px; padding: 28px; box-shadow: 0 24px 60px rgba(0,0,0,.45); }
      .msc-field { margin-bottom: 18px; }
      .msc-field label { display: block; font-size: 13px; font-weight: 600; color: #CBD5E1; margin-bottom: 8px; }
      .msc-field input { width: 100%; min-height: 48px; padding: 12px 14px; font-size: 15px; color: #F8FAFC; background: #0A151D; border: 1px solid #1B3544; border-radius: 11px; outline: none; transition: border-color .15s ease, box-shadow .15s ease; }
      .msc-field input::placeholder { color: #5B6B7E; }
      .msc-field input:focus { border-color: #10B981; box-shadow: 0 0 0 3px rgba(16,185,129,.18); }
      .msc-submit { width: 100%; min-height: 50px; border: 1px solid rgba(52,211,153,.45); border-radius: 11px; background: linear-gradient(135deg, #10B981, #059669); color: #04130D; font-size: 15px; font-weight: 800; cursor: pointer; box-shadow: 0 8px 26px rgba(16,185,129,.28); transition: filter .15s ease, transform .15s ease; }
      .msc-submit:hover { filter: brightness(1.08); transform: translateY(-1px); }
      .msc-submit:focus-visible { outline: 2px solid #34D399; outline-offset: 3px; }
      .msc-error { border-radius: 11px; background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.35); color: #FCA5A5; padding: 12px 14px; font-size: 13.5px; margin-bottom: 18px; }
      .msc-login__foot { margin-top: 22px; text-align: center; font-size: 12px; color: #475569; }
      .msc-login__foot a { color: #34D399; text-decoration: none; }
      .msc-login__foot a:hover { text-decoration: underline; }
      @media (max-width: 479px) { .msc-login__card { padding: 22px 18px; } .msc-login__title { font-size: 1.35rem; } }
    </style>
    <%= render "super_admin/devise/sessions/login_theme" %>
    <style>
      .msc-login__theme { display:flex; justify-content:center; margin-bottom:18px; }
      html[data-msc-theme="light"] body, html[data-msc-theme="light"] .msc-login { background:#F4F7F6 !important; color:#0B1620 !important; }
      html[data-msc-theme="light"] .msc-login__card { background:white; border-color:#E2E8F0; box-shadow:0 20px 60px #0f172a10; }
      html[data-msc-theme="light"] .msc-login__title { color:#0B1620; }
      html[data-msc-theme="light"] .msc-login__sub, html[data-msc-theme="light"] .msc-login__foot { color:#64748B; }
      html[data-msc-theme="light"] .msc-field label { color:#334155; }
      html[data-msc-theme="light"] .msc-field input { background:#F1F5F4; color:#0B1620; border-color:#CBD5E1; }
    </style>
  </head>
  <body>
    <main class="msc-login">
      <div class="msc-login__wrap">
        <section class="msc-login__brand">
          <div class="msc-login__logo"><img src="<%= brand_logo %>" alt="<%= brand_name %>"></div>
          <p class="msc-login__eyebrow"><%= brand_name %> · Super Admin</p>
          <h1 class="msc-login__title">Console de Administração</h1>
          <p class="msc-login__sub">Acesso restrito a administradores da plataforma.</p>
        </section>
        <div class="msc-login__theme"><%= render "super_admin/application/theme_toggle" %></div>
        <section class="msc-login__card">
          <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in') do |f| %>
            <% if flash[:error].present? || flash[:alert].present? %>
              <div data-alert class="msc-error" role="alert"><%= flash[:error].presence || flash[:alert] %></div>
            <% end %>
            <div class="msc-field">
              <label for="super_admin_email">E-mail</label>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "admin@empresa.com", id: "super_admin_email" %>
            </div>
            <div class="msc-field">
              <label for="super_admin_password">Senha</label>
              <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", id: "super_admin_password" %>
            </div>
            <button type="submit" class="msc-submit">Entrar no console</button>
          <% end %>
        </section>
        <p class="msc-login__foot">© <%= Time.current.year %> <%= brand_name %> · <a href="<%= brand_url %>"><%= brand_host %></a></p>
      </div>
    </main>
  </body>
</html>
