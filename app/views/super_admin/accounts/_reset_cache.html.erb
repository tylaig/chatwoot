<section class="main-content__body">
  <div class="msc-card">
    <h2 class="msc-card__title">Cache do frontend</h2>
    <p class="msc-card__desc">Remove as chaves de cache IndexedDB do Redis. O próximo carregamento buscará os dados diretamente do backend.</p>
    <%= form_for([:reset_cache, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
      <div class="form-actions" style="margin-top:14px !important;"><%= f.submit 'Limpar cache do frontend', class: 'msc-btn-ghost' %></div>
    <% end %>
  </div>
</section>
