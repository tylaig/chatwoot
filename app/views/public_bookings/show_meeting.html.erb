<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sala de Vídeo • <%= @global_config['BRAND_NAME'].presence || 'Meu Super Chat' %></title>
  <link rel="icon" type="image/png" href="/favicon-32x32.png" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg-base: #04090D;
      --bg-card: #081218;
      --bg-elevated: #0A151D;
      --border: #142633;
      --accent: #10B981;
      --text: #F8FAFC;
      --muted: #94A3B8;
    }
    body {
      min-height: 100vh;
      background: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.1) 0%, var(--bg-base) 60%);
      color: var(--text);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      display: flex;
      flex-direction: column;
    }
    .room-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 24px;
      border-bottom: 1px solid var(--border);
      background: rgba(8, 18, 24, 0.9);
      backdrop-filter: blur(12px);
      flex-wrap: wrap;
      gap: 12px;
    }
    .brand-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
    }
    .brand-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.8);
    }
    .room-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.14);
      border: 1px solid rgba(16, 185, 129, 0.35);
      color: #6EE7B7;
      font-size: 11px;
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
    }
    .lobby-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 28px 16px;
    }
    .lobby-card {
      width: 100%;
      max-width: 620px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 36px 30px;
      text-align: center;
      box-shadow: 0 28px 80px rgba(0,0,0,0.65);
    }
    .video-icon-ring {
      width: 64px;
      height: 64px;
      border-radius: 20px;
      margin: 0 auto 18px;
      background: rgba(16, 185, 129, 0.14);
      border: 1px solid rgba(16, 185, 129, 0.38);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
    }
    .info-box {
      background: var(--bg-base);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px 18px;
      margin: 20px 0;
      text-align: left;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      font-size: 13px;
    }
    .info-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .info-val {
      font-weight: 600;
      color: var(--text);
    }
    .btn-join {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 14px 24px;
      border-radius: 14px;
      border: none;
      background: linear-gradient(135deg, #10B981 0%, #059669 100%);
      color: #04090D;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      box-shadow: 0 10px 26px rgba(16, 185, 129, 0.3);
      transition: transform 0.15s ease, filter 0.15s ease;
    }
    .btn-join:hover {
      transform: translateY(-1px);
      filter: brightness(1.06);
    }
    #conference-stage {
      display: none;
      flex: 1;
      width: 100%;
      height: calc(100vh - 61px);
      background: #020508;
    }
    #conference-stage iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
  </style>
</head>
<body>
  <% room_uid = (@appointment&.uid.presence || params[:uid].to_s.strip.presence || 'sala-executiva') %>
  <header class="room-header">
    <div class="brand-pill">
      <span class="brand-dot"></span>
      <span>Sala de Vídeo • <%= @global_config['BRAND_NAME'].presence || 'Meu Super Chat' %></span>
    </div>
    <div class="room-badge">
      <span>SESSÃO CRIPTOGRAFADA • <%= room_uid %></span>
    </div>
  </header>

  <main id="lobby-stage" class="lobby-wrap">
    <div class="lobby-card">
      <div class="video-icon-ring">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
      </div>

      <% if @appointment %>
        <h1 style="font-size:22px;font-weight:700;margin-bottom:6px;"><%= @appointment.title %></h1>
        <p style="color:#94A3B8;font-size:13px;">Sala executiva dedicada e sincronizada pelo Meu Super Chat</p>

        <div class="info-box">
          <div>
            <div class="info-label">Especialista</div>
            <div class="info-val"><%= @appointment.calendar_schedule&.name || 'Equipe Meu Super Chat' %></div>
          </div>
          <div>
            <div class="info-label">Participante</div>
            <div class="info-val"><%= @appointment.customer_name %></div>
          </div>
          <div>
            <div class="info-label">Data</div>
            <div class="info-val"><%= @appointment.starts_at.in_time_zone(@appointment.timezone).strftime('%d/%m/%Y') %></div>
          </div>
          <div>
            <div class="info-label">Horário</div>
            <div class="info-val" style="color:#10B981;font-family:'JetBrains Mono',monospace;">
              <%= @appointment.starts_at.in_time_zone(@appointment.timezone).strftime('%H:%M') %> — <%= @appointment.ends_at.in_time_zone(@appointment.timezone).strftime('%H:%M') %>
            </div>
          </div>
        </div>
      <% else %>
        <h1 style="font-size:22px;font-weight:700;margin-bottom:6px;">Sala de Vídeo Meu Super Chat</h1>
        <p style="color:#94A3B8;font-size:13px;margin-bottom:20px;">Sua conferência está pronta para iniciar com áudio e vídeo em alta definição.</p>
      <% end %>

      <button type="button" id="enter-room-btn" class="btn-join">
        <span>Entrar na Sala de Vídeo Agora</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </div>
  </main>

  <div id="conference-stage"></div>

  <script>
    (function() {
      var btn = document.getElementById('enter-room-btn');
      var lobby = document.getElementById('lobby-stage');
      var stage = document.getElementById('conference-stage');
      var roomCode = <%= raw ("MeuSuperChat-" + room_uid.to_s.gsub(/[^a-zA-Z0-9_-]/, '')).to_json %>;
      if (btn) {
        btn.onclick = function() {
          lobby.style.display = 'none';
          stage.style.display = 'block';
          var iframe = document.createElement('iframe');
          iframe.allow = 'camera; microphone; fullscreen; display-capture; autoplay';
          iframe.src = 'https://meet.ffmuc.net/' + encodeURIComponent(roomCode) + '#config.prejoinPageEnabled=false&config.disableDeepLinking=true';
          stage.appendChild(iframe);
        };
      }
    })();
  </script>
</body>
</html>
