<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sala de Reunião • <%= @global_config['BRAND_NAME'].presence || 'Meu Super Chat' %></title>
  <link rel="icon" type="image/png" href="/favicon-32x32.png" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      background: #04090D;
      color: #F8FAFC;
      font-family: 'Inter', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }
    .card {
      width: 100%;
      max-width: 560px;
      background: #081218;
      border: 1px solid #162936;
      border-radius: 20px;
      padding: 32px 26px;
      text-align: center;
      box-shadow: 0 24px 60px rgba(0,0,0,0.65);
    }
    .badge {
      display: inline-flex;
      padding: 5px 12px;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.35);
      color: #6EE7B7;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 14px;
    }
    .btn {
      display: inline-block;
      margin-top: 18px;
      padding: 12px 22px;
      border-radius: 10px;
      background: #10B981;
      color: #04090D;
      font-weight: 700;
      font-size: 13px;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="badge">Sala de Reunião • Meu Super Chat</div>
    <% if @appointment %>
      <h1 style="font-size:21px;font-weight:700;margin-bottom:8px;"><%= @appointment.title %></h1>
      <p style="color:#94A3B8;font-size:13px;margin-bottom:18px;">
        Profissional: <strong style="color:#F8FAFC;"><%= @appointment.calendar_schedule&.name %></strong><br/>
        Cliente: <strong style="color:#F8FAFC;"><%= @appointment.customer_name %></strong>
      </p>
      <div style="background:#04090D;border:1px solid #162936;border-radius:12px;padding:14px;font-size:13px;color:#CBD5E1;">
        Horário confirmado: <strong><%= @appointment.starts_at.in_time_zone(@appointment.timezone).strftime('%d/%m/%Y') %></strong>
        das <strong><%= @appointment.starts_at.in_time_zone(@appointment.timezone).strftime('%H:%M') %></strong>
        às <strong><%= @appointment.ends_at.in_time_zone(@appointment.timezone).strftime('%H:%M') %></strong>
      </div>
      <a href="https://meet.jit.si/MeuSuperChat-<%= @appointment.uid %>" class="btn">Entrar na Videochamada Agora →</a>
    <% else %>
      <h1 style="font-size:19px;">Sala de reunião pronta</h1>
      <p style="color:#94A3B8;font-size:13px;margin-top:8px;">Código da sessão: <%= params[:uid] %></p>
      <a href="https://meet.jit.si/MeuSuperChat-<%= params[:uid] %>" class="btn">Iniciar Videochamada →</a>
    <% end %>
  </div>
</body>
</html>
