<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Agendar horário • <%= @global_config['BRAND_NAME'].presence || 'Meu Super Chat' %></title>
  <meta name="description" content="Escolha sua data, horário e confirme sua sessão no Meu Super Chat." />
  <meta name="theme-color" content="#04090D" />
  <link rel="icon" type="image/png" href="/favicon-32x32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *,*::before,*::after{box-sizing:border-box}
    :root{--bg:#04090D;--card:#081218;--elev:#0A151D;--elev2:#0D1B24;--line:#132631;--line2:#162936;--ink:#F8FAFC;--muted:#94A3B8;--soft:#CBD5E1;--accent:#10B981;--accent-hi:#34D399;--mint:#6EE7B7;--lime:#C6FF00}
    html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;color-scheme:dark}
    body{overflow-x:hidden;background:radial-gradient(1200px 520px at 50% -10%,rgba(16,185,129,.10),transparent 70%),var(--bg)}
    button,input,textarea{font:inherit}
    button{cursor:pointer}
    button:disabled{cursor:not-allowed;opacity:.55}
    a{color:var(--accent-hi)}
    .site-header{height:64px;border-bottom:1px solid var(--line);background:rgba(8,18,24,.85);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:space-between;padding:0 32px;gap:16px;position:relative;z-index:10}
    .brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px;color:var(--ink);text-decoration:none}
    .brand-dot{width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px rgba(16,185,129,.8)}
    .copy-link{height:44px;padding:0 18px;border:1px solid var(--line2);border-radius:12px;background:var(--elev);color:var(--soft);font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:8px;transition:.15s}
    .copy-link:hover{border-color:rgba(16,185,129,.5);color:var(--mint)}
    .copy-link svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2}
    .page{min-height:calc(100vh - 64px);display:flex;align-items:center;justify-content:center;padding:40px 24px 56px}
    .booking-card{width:min(1060px,100%);min-height:600px;background:var(--card);border:1px solid var(--line2);border-radius:24px;box-shadow:0 30px 80px rgba(0,0,0,.55);position:relative;overflow:hidden;display:grid;grid-template-columns:340px 1fr}
    .booking-card.single{display:block}
    .info-panel{padding:36px 32px;border-right:1px solid var(--line);display:flex;flex-direction:column;min-width:0;background:linear-gradient(180deg,rgba(16,185,129,.05),transparent 40%)}
    .avatar{width:64px;height:64px;border-radius:18px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:22px;color:#04090D;margin-bottom:18px;background:var(--accent);background-size:cover;background-position:center;box-shadow:0 8px 24px rgba(16,185,129,.25)}
    .profile-name{font-size:15px;font-weight:600;color:var(--soft);margin-bottom:2px}
    .profile-role{font-size:13px;color:var(--muted);margin-bottom:16px}
    .meeting-title{font-size:26px;line-height:1.2;font-weight:800;color:var(--ink);margin:0 0 12px;letter-spacing:-.01em}
    .meeting-desc{font-size:15px;line-height:1.55;color:var(--muted);margin:0 0 22px}
    .meeting-meta{display:flex;flex-direction:column;gap:14px;font-size:15px;line-height:1.45;color:var(--soft)}
    .meta-row{display:flex;align-items:flex-start;gap:10px}
    .meta-row.highlight{color:var(--mint);font-weight:600}
    .meta-icon{width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 20px;color:var(--accent)}
    .meta-icon svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.8}
    .type-chips{display:flex;flex-direction:column;gap:8px;margin:0 0 22px}
    .type-chip{min-height:44px;text-align:left;padding:10px 14px;border-radius:12px;border:1px solid var(--line2);background:var(--elev);color:var(--soft);font-size:14px;font-weight:600;transition:.15s}
    .type-chip:hover{border-color:rgba(16,185,129,.45)}
    .type-chip.active{border-color:var(--accent);background:rgba(16,185,129,.12);color:var(--mint)}
    .powered{margin-top:auto;padding-top:28px;font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px}
    .powered strong{color:var(--ink)}
    .powered .brand-dot{width:8px;height:8px}
    .right-panel{padding:36px 36px 32px;min-width:0}
    .section-title{font-size:22px;font-weight:700;margin:0 0 24px;color:var(--ink)}
    .calendar-layout{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:32px}
    .calendar-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
    .month-label{font-size:17px;font-weight:700;color:var(--ink)}.month-label::first-letter{text-transform:uppercase}
    .month-nav{display:flex;align-items:center;gap:8px}
    .month-nav button{width:44px;height:44px;border-radius:12px;border:1px solid var(--line2);background:var(--elev);color:var(--soft);display:inline-flex;align-items:center;justify-content:center;transition:.15s}
    .month-nav button:hover:not(:disabled){border-color:rgba(16,185,129,.5);color:var(--mint)}
    .month-nav svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.2}
    .weekdays,.days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;text-align:center}
    .weekdays{margin-bottom:8px}
    .weekdays span{font-size:12px;font-weight:700;letter-spacing:.06em;color:var(--muted);text-transform:uppercase}
    .days button,.days span{height:48px;border:0;background:transparent;color:#475569;font-size:15px;font-weight:500;padding:0;display:flex;align-items:center;justify-content:center;border-radius:14px;position:relative}
    .days button:disabled{opacity:1;cursor:default}
    .days button.available{color:var(--mint);background:rgba(16,185,129,.12);font-weight:700}
    .days button.available:hover{background:rgba(16,185,129,.22)}
    .days button.today::after{content:"";position:absolute;bottom:7px;width:5px;height:5px;border-radius:50%;background:var(--lime)}
    .days button.selected{background:var(--accent);color:#04090D;font-weight:800;box-shadow:0 6px 18px rgba(16,185,129,.35)}
    .tz{margin-top:22px;font-size:14px;color:var(--muted);display:flex;flex-direction:column;gap:6px}
    .tz-label{font-weight:700;color:var(--soft)}
    .tz-value{display:flex;align-items:center;gap:8px}
    .tz-value svg{width:16px;height:16px;stroke:var(--accent);fill:none;stroke-width:1.8}
    .slots-panel{min-width:0}
    .selected-day{font-size:15px;font-weight:600;color:var(--soft);margin:12px 0 16px}.selected-day::first-letter{text-transform:uppercase}
    .slots{display:flex;flex-direction:column;gap:10px;max-height:420px;overflow-y:auto;padding-right:4px}
    .slots::-webkit-scrollbar{width:6px}.slots::-webkit-scrollbar-thumb{background:var(--line2);border-radius:6px}
    .slot-button{width:100%;height:50px;border:1px solid rgba(16,185,129,.45);border-radius:12px;background:transparent;color:var(--mint);font-size:15px;font-weight:700;transition:.15s}
    .slot-button:hover{background:rgba(16,185,129,.10);border-color:var(--accent)}
    .slot-choice{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .slot-button.selected{background:var(--elev2);border-color:var(--line2);color:var(--ink)}
    .slot-next{height:50px;border:0;border-radius:12px;background:var(--accent);color:#04090D;font-size:15px;font-weight:800;transition:.15s}
    .slot-next:hover{background:var(--accent-hi)}
    .empty-slots{font-size:14px;color:var(--muted);line-height:1.55;padding:16px;border:1px dashed var(--line2);border-radius:12px}
    .form-panel{padding:36px 40px;min-width:0}
    .back-button{width:44px;height:44px;border:1px solid var(--line2);border-radius:12px;background:var(--elev);color:var(--soft);display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px}
    .back-button:hover{border-color:rgba(16,185,129,.5);color:var(--mint)}
    .back-button svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.2}
    .form-inner{max-width:520px}
    .field{display:flex;flex-direction:column;gap:8px;margin-bottom:18px}
    .field label{font-size:14px;font-weight:600;color:var(--soft)}
    .field label .req{color:var(--accent)}
    .field input,.field textarea{width:100%;border:1px solid var(--line2);border-radius:12px;background:var(--elev);color:var(--ink);outline:0;padding:12px 14px;font-size:15px;transition:.15s}
    .field input{height:48px}.field textarea{min-height:110px;resize:vertical;line-height:1.5}
    .field input::placeholder,.field textarea::placeholder{color:#475569}
    .field input:focus,.field textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(16,185,129,.18)}
    .guest-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:-4px 0 18px}
    .guest-button{min-height:44px;padding:0 16px;border:1px solid rgba(16,185,129,.5);background:transparent;color:var(--mint);border-radius:12px;font-size:14px;font-weight:600}
    .guest-tag{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:rgba(16,185,129,.12);color:var(--mint);font-size:13px}
    .form-hint{font-size:13px;line-height:1.6;color:var(--muted);margin:0 0 20px}
    .primary-button{min-height:50px;border:0;border-radius:12px;background:var(--accent);color:#04090D;font-size:15px;font-weight:800;padding:0 28px;transition:.15s;box-shadow:0 8px 24px rgba(16,185,129,.25)}
    .primary-button:hover:not(:disabled){background:var(--accent-hi)}
    .form-error{background:rgba(239,68,68,.10);border:1px solid rgba(239,68,68,.4);color:#FCA5A5;border-radius:12px;padding:12px 14px;font-size:14px;margin-bottom:18px}
    .confirmed{display:flex;flex-direction:column;align-items:center;text-align:center;padding:64px 32px;min-height:600px;justify-content:center}
    .confirm-badge{width:72px;height:72px;border-radius:22px;background:rgba(16,185,129,.14);border:1px solid rgba(16,185,129,.4);display:flex;align-items:center;justify-content:center;margin-bottom:20px;color:var(--accent)}
    .confirm-badge svg{width:36px;height:36px;stroke:currentColor;fill:none;stroke-width:2}
    .confirm-title{font-size:28px;font-weight:800;margin:0 0 10px}
    .confirm-subtitle{font-size:16px;color:var(--muted);margin:0 0 28px;max-width:460px;line-height:1.55}
    .event-summary{width:min(460px,100%);border:1px solid var(--line2);background:var(--elev);border-radius:18px;padding:22px 24px;text-align:left;margin-bottom:24px}
    .event-summary h3{font-size:18px;margin:0 0 14px;color:var(--ink)}
    .event-line{display:flex;align-items:flex-start;gap:10px;font-size:15px;color:var(--soft);margin-top:12px}
    .event-line svg{width:18px;height:18px;stroke:var(--accent);fill:none;stroke-width:1.8;flex:0 0 18px;margin-top:2px}
    .confirm-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
    .ghost-button{min-height:50px;padding:0 22px;border:1px solid var(--line2);border-radius:12px;background:transparent;color:var(--soft);font-size:15px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center}
    .ghost-button:hover{border-color:rgba(16,185,129,.5);color:var(--mint)}
    .loading,.not-found{grid-column:1/-1;min-height:600px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:32px;color:var(--muted);font-size:16px;gap:14px}
    .not-found h2{font-size:24px;color:var(--ink);margin:0}
    .spinner{width:36px;height:36px;border-radius:50%;border:3px solid var(--line2);border-top-color:var(--accent);animation:spin .8s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    @media (max-width:980px){.calendar-layout{grid-template-columns:1fr;gap:24px}.slots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-height:none}.slot-choice{grid-column:1/-1}}
    @media (max-width:860px){.site-header{padding:0 18px}.page{align-items:flex-start;padding:20px 14px 40px}.booking-card{grid-template-columns:1fr;min-height:0}.info-panel{border-right:0;border-bottom:1px solid var(--line);padding:28px 24px}.powered{padding-top:20px}.right-panel,.form-panel{padding:28px 24px}.confirmed{min-height:0;padding:48px 22px}}
    @media (max-width:520px){.site-header{height:60px;padding:0 14px}.copy-link{padding:0 12px}.copy-link .label{display:none}.page{padding:14px 10px 32px}.booking-card{border-radius:20px}.info-panel,.right-panel,.form-panel{padding:22px 18px}.meeting-title{font-size:22px}.section-title{font-size:20px}.days{gap:4px}.days button,.days span{height:44px;font-size:15px;border-radius:12px}.slots{grid-template-columns:repeat(2,minmax(0,1fr))}.confirm-title{font-size:24px}}
  </style>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/"><span class="brand-dot"></span><span><%= @global_config['BRAND_NAME'].presence || 'Meu Super Chat' %></span></a>
    <button type="button" id="copy-link" class="copy-link" aria-label="Copiar link da página"><svg viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span class="label">Copiar link</span></button>
  </header>
  <main class="page"><div id="booking-root" class="booking-card single"><div class="loading"><div class="spinner"></div>Carregando agenda...</div></div></main>

  <script>
    (function(){
      const slug = <%= raw @slug.to_json %>;
      const companySlug = <%= raw (@company_slug.presence || "").to_json %>;
      const apiQs = extra => { const p = new URLSearchParams(extra || {}); if (companySlug) p.set("company_slug", companySlug); const s = p.toString(); return s ? "?" + s : ""; };
      const root = document.getElementById('booking-root');
      const MONTHS = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
      const WEEKDAYS = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
      const WEEKDAYS_LONG = ['domingo','segunda-feira','terça-feira','quarta-feira','quinta-feira','sexta-feira','sábado'];
      const icons = {
        clock:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
        video:'<svg viewBox="0 0 24 24"><path d="m15 10 5-3v10l-5-3z"/><rect x="3" y="6" width="12" height="12" rx="2"/></svg>',
        globe:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>',
        calendar:'<svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 9h16"/></svg>',
        user:'<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>',
        check:'<svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg>',
        left:'<svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>',
        right:'<svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>'
      };
      let state = { loading:true, notFound:false, accountName:'', schedules:[], selectedScheduleId:null, appointmentTypes:[], selectedTypeId:null, currentMonth:new Date(new Date().getFullYear(),new Date().getMonth(),1), availabilityByDate:{}, selectedDate:null, selectedSlot:null, step:'select_slot', submitting:false, errorMsg:'', confirmedAppointment:null, form:{name:'',email:'',phone:'',notes:'',guest_emails:[]} };
      const esc = value => String(value == null ? '' : value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const iso = date => { const y=date.getFullYear(),m=String(date.getMonth()+1).padStart(2,'0'),d=String(date.getDate()).padStart(2,'0'); return `${y}-${m}-${d}`; };
      const dateFromIso = value => { const [y,m,d]=String(value).split('-').map(Number); return new Date(y,m-1,d); };
      const selectedSchedule = () => state.schedules.find(s => Number(s.id) === Number(state.selectedScheduleId)) || state.schedules[0];
      const typeList = () => { const s=selectedSchedule(); return (s && s.appointment_types && s.appointment_types.length) ? s.appointment_types : state.appointmentTypes; };
      const selectedType = () => { const list=typeList(); return list.find(t=>Number(t.id)===Number(state.selectedTypeId)) || list[0]; };
      const formatDate = value => { if(!value) return ''; const d=dateFromIso(value); return `${WEEKDAYS_LONG[d.getDay()]}, ${d.getDate()} de ${MONTHS[d.getMonth()]}`; };
      const formatDateLong = value => { if(!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return value || ''; const d=dateFromIso(value); return `${WEEKDAYS_LONG[d.getDay()]}, ${d.getDate()} de ${MONTHS[d.getMonth()]} de ${d.getFullYear()}`; };
      const getDuration = () => Number(selectedType()?.duration_minutes || selectedSchedule()?.slot_duration_minutes || 30);
      const selectedSlotDate = () => state.selectedSlot ? (state.selectedSlot.date || state.selectedDate) : state.selectedDate;
      const tzNow = () => { try { return new Intl.DateTimeFormat('pt-BR',{hour:'2-digit',minute:'2-digit',timeZone:selectedSchedule()?.timezone||'America/Sao_Paulo'}).format(new Date()); } catch(e){ return ''; } };
      const initials = name => String(name||'MS').split(' ').filter(Boolean).map(n=>n[0]).slice(0,2).join('').toUpperCase();
      const locationLabel = srv => (srv && srv.location_type === 'google_meet') ? 'Videochamada — link enviado após a confirmação' : 'Detalhes da reunião enviados após a confirmação';

      async function loadProfile(){
        try{
          const response=await fetch('/public/api/v1/bookings/'+encodeURIComponent(slug)+apiQs());
          if(!response.ok) throw new Error('not found');
          const data=await response.json();
          state.accountName=data.account_name || 'Meu Super Chat'; state.schedules=data.schedules||[]; state.appointmentTypes=data.appointment_types||[];
          if(state.schedules.length){state.selectedScheduleId=state.schedules[0].id; const types=state.schedules[0].appointment_types||[]; if(types.length) state.selectedTypeId=types[0].id;}
          if(!state.selectedTypeId && state.appointmentTypes.length) state.selectedTypeId=state.appointmentTypes[0].id;
          await loadSlots();
        }catch(e){state.loading=false;state.notFound=true;render();}
      }
      async function loadSlots(){
        state.availabilityByDate={};
        const today=new Date(); today.setHours(0,0,0,0);
        const start=new Date(Math.max(state.currentMonth.getTime(),today.getTime()));
        const qs=new URLSearchParams({date:iso(start),days:'35'}); if(companySlug) qs.set('company_slug',companySlug); if(state.selectedScheduleId) qs.set('schedule_id',state.selectedScheduleId); if(state.selectedTypeId) qs.set('appointment_type_id',state.selectedTypeId);
        try{const response=await fetch('/public/api/v1/bookings/'+encodeURIComponent(slug)+'/slots?'+qs.toString()); const data=await response.json(); (data.availability||[]).forEach(entry=>{state.availabilityByDate[entry.date]=entry.slots||[];});}catch(e){}
        const dates=Object.keys(state.availabilityByDate).filter(d=>(state.availabilityByDate[d]||[]).length).sort();
        if(!state.selectedDate || !(state.availabilityByDate[state.selectedDate]||[]).length) state.selectedDate=dates[0]||null;
        state.loading=false; render();
      }
      function changeMonth(offset){state.currentMonth=new Date(state.currentMonth.getFullYear(),state.currentMonth.getMonth()+offset,1);state.selectedDate=null;state.selectedSlot=null;loadSlots();}
      function chooseDate(date){state.selectedDate=date;state.selectedSlot=null;render();}
      function chooseSlot(slot){state.selectedSlot=slot;state.step='select_slot';render();}
      function chooseType(id){state.selectedTypeId=id;state.selectedSlot=null;loadSlots();}
      function continueToForm(){if(!state.selectedSlot)return;state.step='fill_form';render();window.scrollTo({top:0,behavior:'smooth'});}
      async function submitBooking(event){event.preventDefault(); if(!state.form.name.trim()||!state.form.email.trim()){state.errorMsg='Preencha nome e e-mail para continuar.';render();return;} state.submitting=true;state.errorMsg='';render(); try{const payload={company_slug:companySlug||undefined,calendar_schedule_id:state.selectedSlot.calendar_schedule_id||state.selectedScheduleId,appointment_type_id:state.selectedTypeId,starts_at:state.selectedSlot.starts_at,customer_name:state.form.name.trim(),customer_email:state.form.email.trim(),customer_phone:state.form.phone.trim(),notes:state.form.notes.trim(),guest_emails:state.form.guest_emails}; const response=await fetch('/public/api/v1/bookings/'+encodeURIComponent(slug)+'/book',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const data=await response.json();if(!response.ok)throw new Error(data.error||'Não foi possível concluir o agendamento.');state.confirmedAppointment=data.appointment;state.step='confirmed';}catch(e){state.errorMsg=e.message||'Erro de conexão ao confirmar agendamento.';}finally{state.submitting=false;render();}}

      function baseInfo(s,srv,formMode){
        const duration=getDuration(); const color=s.color||'#10B981';
        const avatar = s.avatar_url ? `<div class="avatar" style="background-image:url('${esc(s.avatar_url)}')"></div>` : `<div class="avatar" style="background:${esc(color)}">${esc(initials(s.name))}</div>`;
        const types=typeList();
        const chips = (!formMode && types.length>1) ? `<div class="type-chips">${types.map(t=>`<button type="button" class="type-chip ${Number(t.id)===Number(srv&&srv.id)?'active':''}" data-type="${t.id}">${esc(t.title)}</button>`).join('')}</div>` : '';
        const slotInfo = (formMode && state.selectedSlot) ? `<div class="meta-row highlight"><span class="meta-icon">${icons.calendar}</span><span>${esc(state.selectedSlot.time)}${state.selectedSlot.end_time?' – '+esc(state.selectedSlot.end_time):''}, ${esc(formatDateLong(selectedSlotDate()))}</span></div>` : '';
        return `<section class="info-panel"><div>${avatar}<div class="profile-name">${esc(s.name||'Meu Super Chat')}</div>${s.role_title?`<div class="profile-role">${esc(s.role_title)}</div>`:''}<h1 class="meeting-title">${esc((srv&&srv.title)||'Reunião de 30 minutos')}</h1>${srv&&srv.description?`<p class="meeting-desc">${esc(srv.description)}</p>`:''}${chips}<div class="meeting-meta"><div class="meta-row"><span class="meta-icon">${icons.clock}</span><span>${duration} min</span></div><div class="meta-row"><span class="meta-icon">${icons.video}</span><span>${locationLabel(srv)}</span></div>${slotInfo}<div class="meta-row"><span class="meta-icon">${icons.globe}</span><span>Horário de Brasília</span></div></div></div><footer class="powered"><span class="brand-dot"></span>Powered by <strong>Meu Super Chat</strong></footer></section>`;
      }
      function renderSelection(s,srv){
        const year=state.currentMonth.getFullYear(),month=state.currentMonth.getMonth(),first=new Date(year,month,1).getDay(),days=new Date(year,month+1,0).getDate();
        const now=new Date(); const todayIso=iso(now); const isCurrentMonth=(year===now.getFullYear()&&month===now.getMonth());
        let cells='';for(let i=0;i<first;i++)cells+='<span></span>';
        for(let d=1;d<=days;d++){const value=iso(new Date(year,month,d)),available=(state.availabilityByDate[value]||[]).length>0,selected=state.selectedDate===value;cells+=`<button type="button" class="${available?'available':''} ${selected?'selected':''} ${value===todayIso?'today':''}" data-date="${value}" ${available?'':'disabled'} aria-label="${d} de ${MONTHS[month]}">${d}</button>`;}
        const slots=state.selectedDate?(state.availabilityByDate[state.selectedDate]||[]):[];
        const slotsHtml=slots.length?slots.map((slot,index)=>{const active=state.selectedSlot&&state.selectedSlot.starts_at===slot.starts_at;return active?`<div class="slot-choice"><button type="button" class="slot-button selected" data-slot="${index}">${esc(slot.time)}</button><button type="button" class="slot-next" id="slot-next">Próximo</button></div>`:`<button type="button" class="slot-button" data-slot="${index}">${esc(slot.time)}</button>`;}).join(''):'<p class="empty-slots">Nenhum horário livre neste mês. Use as setas para ver os próximos meses.</p>';
        return `<div class="right-panel"><h2 class="section-title">Selecione data e horário</h2><div class="calendar-layout"><div><div class="calendar-top"><span class="month-label">${MONTHS[month]} ${year}</span><div class="month-nav"><button type="button" id="prev-month" aria-label="Mês anterior" ${isCurrentMonth?'disabled':''}>${icons.left}</button><button type="button" id="next-month" aria-label="Próximo mês">${icons.right}</button></div></div><div class="weekdays">${WEEKDAYS.map(d=>`<span>${d}</span>`).join('')}</div><div class="days">${cells}</div><div class="tz"><span class="tz-label">Fuso horário</span><span class="tz-value">${icons.globe} Horário de Brasília (${tzNow()})</span></div></div><div class="slots-panel"><p class="selected-day">${state.selectedDate?formatDate(state.selectedDate):'Escolha um dia'}</p><div class="slots">${slotsHtml}</div></div></div></div>`;
      }
      function renderForm(){
        const guests=state.form.guest_emails.map(g=>`<span class="guest-tag">${esc(g)}</span>`).join('');
        return `<div class="form-panel"><button type="button" id="back" class="back-button" aria-label="Voltar">${icons.left}</button><div class="form-inner"><h2 class="section-title">Seus dados</h2>${state.errorMsg?`<div class="form-error">${esc(state.errorMsg)}</div>`:''}<form id="booking-form" novalidate><div class="field"><label for="name">Nome <span class="req">*</span></label><input id="name" required autocomplete="name" placeholder="Seu nome completo" value="${esc(state.form.name)}" /></div><div class="field"><label for="email">E-mail <span class="req">*</span></label><input id="email" required type="email" autocomplete="email" placeholder="voce@empresa.com" value="${esc(state.form.email)}" /></div><div class="field"><label for="phone">WhatsApp</label><input id="phone" type="tel" autocomplete="tel" placeholder="(11) 99999-9999" value="${esc(state.form.phone)}" /></div><div class="guest-row"><button type="button" id="add-guests" class="guest-button">+ Adicionar convidados</button>${guests}</div><div class="field"><label for="notes">Conte o que podemos preparar para a reunião</label><textarea id="notes" placeholder="Ex.: volume de atendimentos, canais que usa hoje, objetivos...">${esc(state.form.notes)}</textarea></div><p class="form-hint">Ao continuar, você concorda com os Termos de Uso e a Política de Privacidade do Meu Super Chat.</p><button class="primary-button" type="submit" ${state.submitting?'disabled':''}>${state.submitting?'Agendando...':'Confirmar agendamento'}</button></form></div></div>`;
      }
      function renderConfirmed(s,srv){
        const appt=state.confirmedAppointment||{};
        const when=`${esc(appt.start_time||state.selectedSlot?.time||'')}${(appt.end_time||state.selectedSlot?.end_time)?' – '+esc(appt.end_time||state.selectedSlot?.end_time):''}, ${esc(formatDateLong(appt.date||selectedSlotDate()))}`;
        const meet=appt.meeting_url?`<a class="primary-button" style="display:inline-flex;align-items:center;text-decoration:none" href="${esc(appt.meeting_url)}" target="_blank" rel="noopener">Abrir sala da reunião</a>`:'';
        return `<div class="confirmed"><div class="confirm-badge">${icons.check}</div><h2 class="confirm-title">Agendamento confirmado!</h2><p class="confirm-subtitle">Enviamos o convite com todos os detalhes para o seu e-mail.</p><div class="event-summary"><h3>${esc((srv&&srv.title)||'Reunião')}</h3><div class="event-line">${icons.user}<span>${esc(appt.professional_name||s.name)}</span></div><div class="event-line">${icons.calendar}<span>${when}</span></div><div class="event-line">${icons.globe}<span>Horário de Brasília</span></div><div class="event-line">${icons.video}<span>${locationLabel(srv)}</span></div></div><div class="confirm-actions">${meet}<button type="button" id="book-another" class="ghost-button">Agendar outro horário</button></div></div>`;
      }
      function render(){
        if(state.loading)return;
        if(state.notFound||!state.schedules.length){root.className='booking-card single';root.innerHTML='<div class="not-found"><h2>Página de agendamento não encontrada</h2><p>Verifique o link enviado pelo profissional.</p></div>';return;}
        const s=selectedSchedule(),srv=selectedType();
        if(state.step==='fill_form'){root.className='booking-card';root.innerHTML=baseInfo(s,srv,true)+renderForm();bindForm();return;}
        if(state.step==='confirmed'){root.className='booking-card single';root.innerHTML=renderConfirmed(s,srv);const again=document.getElementById('book-another');if(again)again.onclick=()=>{state.step='select_slot';state.selectedSlot=null;state.confirmedAppointment=null;loadSlots();};return;}
        root.className='booking-card';root.innerHTML=baseInfo(s,srv,false)+renderSelection(s,srv);bindSelection();
      }
      function bindSelection(){
        const p=document.getElementById('prev-month'),n=document.getElementById('next-month');if(p)p.onclick=()=>changeMonth(-1);if(n)n.onclick=()=>changeMonth(1);
        root.querySelectorAll('[data-date]').forEach(b=>b.onclick=()=>chooseDate(b.dataset.date));
        root.querySelectorAll('[data-slot]').forEach(b=>b.onclick=()=>chooseSlot((state.availabilityByDate[state.selectedDate]||[])[Number(b.dataset.slot)]));
        root.querySelectorAll('[data-type]').forEach(b=>b.onclick=()=>chooseType(Number(b.dataset.type)));
        const next=document.getElementById('slot-next');if(next)next.onclick=continueToForm;
      }
      function syncForm(){['name','email','phone','notes'].forEach(k=>{const el=document.getElementById(k);if(el)state.form[k]=el.value;});}
      function bindForm(){
        document.getElementById('back').onclick=()=>{syncForm();state.step='select_slot';state.errorMsg='';render();};
        document.getElementById('add-guests').onclick=()=>{syncForm();const email=window.prompt('E-mail do convidado');if(email&&email.trim()){state.form.guest_emails.push(email.trim());render();}};
        document.getElementById('booking-form').onsubmit=e=>{syncForm();submitBooking(e);};
      }
      document.getElementById('copy-link').onclick=()=>{navigator.clipboard?.writeText(window.location.href);const l=document.querySelector('#copy-link .label');if(l){l.textContent='Link copiado!';setTimeout(()=>{l.textContent='Copiar link';},1800);}};
      loadProfile();
    })();
  </script>
</body>
</html>
