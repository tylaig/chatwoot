    <script id="msc-campaigns-refactor-v1-script">
      (function() {
        var isSyncing = false;
        var rafPending = false;

        function syncCampaignsPage() {
          if (isSyncing) return;
          isSyncing = true;
          try {
            var path = window.location.pathname || '';
            var m = path.match(/^\/app\/accounts\/(\d+)\/campaigns\/(live_chat|whatsapp|sms)/);
            var isCampaigns = !!m;

            if (document.body.classList.contains('msc-campaigns-page') !== isCampaigns) {
              document.body.classList.toggle('msc-campaigns-page', isCampaigns);
            }

            if (!isCampaigns) {
              var oldNav = document.getElementById('msc-campaigns-quicknav');
              if (oldNav) oldNav.remove();
              return;
            }

            var accId = m[1];
            var currentTab = m[2];
            var container = document.querySelector('main > .w-full.max-w-5xl.mx-auto');

            if (container) {
              var activeCards = container.querySelectorAll(':scope > .flex.flex-col.gap-4 > [class*="group/cardLayout"]').length;
              var nav = document.getElementById('msc-campaigns-quicknav');
              if (!nav) {
                nav = document.createElement('div');
                nav.id = 'msc-campaigns-quicknav';
                container.insertBefore(nav, container.firstChild);
              }

              var expectedKey = accId + ':' + currentTab + ':' + activeCards;
              if (nav.getAttribute('data-state') !== expectedKey) {
                nav.setAttribute('data-state', expectedKey);
                var countLabel = currentTab === 'sms'
                  ? 'Canal SMS pronto para integração'
                  : (activeCards + (activeCards === 1 ? ' campanha configurada' : ' campanhas configuradas'));

                nav.innerHTML =
                  '<div class="msc-cq-tabs">' +
                    '<a class="msc-cq-tab ' + (currentTab === 'live_chat' ? 'active' : '') + '" data-nav="/app/accounts/' + accId + '/campaigns/live_chat" href="/app/accounts/' + accId + '/campaigns/live_chat">Chat ao Vivo</a>' +
                    '<a class="msc-cq-tab ' + (currentTab === 'whatsapp' ? 'active' : '') + '" data-nav="/app/accounts/' + accId + '/campaigns/whatsapp" href="/app/accounts/' + accId + '/campaigns/whatsapp">WhatsApp Oficial</a>' +
                    '<a class="msc-cq-tab ' + (currentTab === 'sms' ? 'active' : '') + '" data-nav="/app/accounts/' + accId + '/campaigns/sms" href="/app/accounts/' + accId + '/campaigns/sms">SMS Corporativo</a>' +
                  '</div>' +
                  '<div class="msc-cq-meta"><span class="msc-cq-dot"></span><span>' + countLabel + '</span></div>';

                nav.querySelectorAll('a[data-nav]').forEach(function(a) {
                  a.addEventListener('click', function(ev) {
                    ev.preventDefault();
                    var target = a.getAttribute('data-nav');
                    if (target && window.location.pathname !== target) {
                      window.history.pushState({}, '', target);
                      window.dispatchEvent(new PopStateEvent('popstate'));
                    }
                  });
                });
              }

              // Fix literal translation "ativado out 22" -> "em out 22"
              container.querySelectorAll('span.whitespace-nowrap').forEach(function(sp) {
                if ((sp.textContent || '').trim() === 'ativado') {
                  sp.textContent = 'em';
                }
              });

              // Localize & sanitize SMS empty-state preview background cards (remove chwt.app & English dummy text)
              if (currentTab === 'sms') {
                container.querySelectorAll('.pointer-events-none [class*="group/cardLayout"]').forEach(function(card, idx) {
                  if (card.getAttribute('data-msc-localized') === '1') return;
                  card.setAttribute('data-msc-localized', '1');
                  var titleEl = card.querySelector('.capitalize');
                  var msgEl = card.querySelector('p');
                  if (idx === 0) {
                    if (titleEl) titleEl.textContent = 'Confirmação Executiva • Sessão Diagnóstico 360';
                    if (msgEl) msgEl.textContent = 'Olá! Seu horário com a equipe Meu Super Chat está confirmado. Acesse os detalhes em: https://agenda.meusuper.app';
                  } else if (idx === 1) {
                    if (titleEl) titleEl.textContent = 'Boas-vindas VIP • Onboarding Omnichannel';
                    if (msgEl) msgEl.textContent = 'Bem-vindo ao Meu Super Chat! Seu ambiente Enterprise já está liberado e pronto para operação.';
                  } else {
                    if (titleEl) titleEl.textContent = 'Aviso de Renovação & Suporte Prioritário';
                    if (msgEl) msgEl.textContent = 'Fale com nossa equipe a qualquer momento pelo canal oficial do Meu Super Chat.';
                  }
                  card.querySelectorAll('span').forEach(function(s) {
                    if ((s.textContent || '').trim() === 'PaperLayer Mobile') {
                      s.textContent = 'SMS Oficial • Meu Super Chat';
                    }
                  });
                });
              }
            }
          } finally {
            isSyncing = false;
          }
        }

        function scheduleSync() {
          if (rafPending || isSyncing) return;
          rafPending = true;
          requestAnimationFrame(function() {
            rafPending = false;
            syncCampaignsPage();
          });
        }

        var obs = new MutationObserver(scheduleSync);
        if (document.body) {
          obs.observe(document.body, { childList: true, subtree: true });
        } else {
          document.addEventListener('DOMContentLoaded', function() {
            obs.observe(document.body, { childList: true, subtree: true });
            syncCampaignsPage();
          });
        }
        window.addEventListener('popstate', scheduleSync);
        syncCampaignsPage();
      })();
    </script>
