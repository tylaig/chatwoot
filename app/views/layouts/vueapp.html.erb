          }
        ];

        function syncBodyDarkClass() {
          if (!document.body) return;
          var isDark = document.documentElement.classList.contains('dark');
          if (isDark && !document.body.classList.contains('dark')) {
            document.body.classList.add('dark');
            document.body.classList.remove('light');
          } else if (!isDark && document.body.classList.contains('dark')) {
            document.body.classList.remove('dark');
            document.body.classList.add('light');
          }
        }

        function getAccountIdFromPath(path) {
          var m = path.match(/^\/app\/accounts\/(\d+)\/reports(?:\/|$)/);
          return m ? m[1] : null;
        }

        function navigateToReport(fullHref, e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          var sidebarLink = document.querySelector('aside a[href="' + fullHref + '"]');
          if (sidebarLink) {
            sidebarLink.click();
            setTimeout(syncReportsPage, 60);
            return;
          }
          window.location.assign(fullHref);
        }

        function syncReportsPage() {
          syncBodyDarkClass();
          var path = window.location.pathname || '';
          var accId = getAccountIdFromPath(path);

          if (!accId) {
            document.body.classList.remove('msc-reports-page');
            var oldNav = document.getElementById('msc-reports-quicknav');
            if (oldNav) oldNav.remove();
            return;
          }

          document.body.classList.add('msc-reports-page');

          var container = document.querySelector('main .max-w-5xl');
          if (!container || !container.parentElement) return;

          var parentWrap = container.parentElement;
          var nav = document.getElementById('msc-reports-quicknav');

          if (!nav) {
            nav = document.createElement('nav');
            nav.id = 'msc-reports-quicknav';
            nav.setAttribute('aria-label', 'Navegação Executiva de Relatórios');

            var brand = document.createElement('div');
            brand.className = 'msc-rnav-brand';
            brand.innerHTML = '<span class="msc-rnav-pulse"></span><span>BI & Analytics</span>';
            nav.appendChild(brand);

            var track = document.createElement('div');
            track.className = 'msc-rnav-track';

            REPORT_TABS.forEach(function(tab) {
              var a = document.createElement('a');
              a.className = 'msc-rnav-pill';
              a.setAttribute('data-report-key', tab.key);
              a.href = '/app/accounts/' + accId + tab.href;
              a.innerHTML = tab.icon + '<span>' + tab.label + '</span>';
              a.addEventListener('click', function(ev) {
                navigateToReport('/app/accounts/' + accId + tab.href, ev);
              });
              track.appendChild(a);
            });

            nav.appendChild(track);
            parentWrap.insertBefore(nav, container);
          }

          // Update active tab state
          var pills = nav.querySelectorAll('.msc-rnav-pill');
          var trackEl = nav.querySelector('.msc-rnav-track');
          pills.forEach(function(pill) {
            var key = pill.getAttribute('data-report-key');
            var tabDef = REPORT_TABS.find(function(t) { return t.key === key; });
            if (!tabDef) return;
            var fullTarget = '/app/accounts/' + accId + tabDef.href;
            if (pill.getAttribute('href') !== fullTarget) {
              pill.setAttribute('href', fullTarget);
            }
            var isActive = tabDef.match.some(function(suffix) {
              return path.endsWith(suffix) || path.indexOf(suffix + '/') !== -1;
            });
            if (isActive) {
              if (!pill.classList.contains('is-active')) {
                pill.classList.add('is-active');
                if (trackEl && trackEl.scrollWidth > trackEl.clientWidth) {
                  var targetScroll = pill.offsetLeft - (trackEl.clientWidth / 2) + (pill.clientWidth / 2);
                  trackEl.scrollLeft = Math.max(0, targetScroll);
                }
              }
            } else {
              pill.classList.remove('is-active');
            }
          });
        }

        // Observe html class changes (dark/light toggle)
        var htmlObs = new MutationObserver(function() {
          syncBodyDarkClass();
        });
        htmlObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        // Observe DOM & route transitions
        var bodyObs = new MutationObserver(function() {
          syncReportsPage();
        });
        if (document.body) {
          bodyObs.observe(document.body, { childList: true, subtree: true });
        } else {
          document.addEventListener('DOMContentLoaded', function() {
            bodyObs.observe(document.body, { childList: true, subtree: true });
            syncReportsPage();
          });
        }

        window.addEventListener('popstate', syncReportsPage);
        syncReportsPage();
      })();
    </script>
