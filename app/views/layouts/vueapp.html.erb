    <script id="msc-captain-refactor-v1-script">
      (function() {
        var isSyncing = false;
        var rafPending = false;

        var EXACT_TRANSLATIONS = {
          'Test setup': 'Configuração do Teste',
          'Changes here apply only to this playground session unless you explicitly save an item.': 'As alterações feitas aqui valem apenas para esta sessão de teste, a menos que você salve o item.',
          'Knowledge': 'Conhecimento',
          'Scenarios': 'Cenários',
          'Guidelines': 'Diretrizes',
          'Guardrails': 'Proteções',
          'Knowledge available to Assistente IA': 'Base de Conhecimento ativa no Assistente IA',
          'Saved sources are summarized here and managed outside the playground.': 'As fontes salvas estão resumidas aqui e são gerenciadas nas abas Documentos e FAQs.',
          'Documents': 'Documentos',
          'Temporary knowledge': 'Conhecimento temporário da sessão',
          'This text is attached only to playground requests unless you add it as a document.': 'Este texto é anexado apenas aos testes desta sessão, a menos que você o salve como documento.',
          'Session only': 'Apenas nesta sessão',
          'Reference text': 'Texto de referência',
          'Add document permanently': 'Salvar como documento permanente',
          'Include in this test': 'Incluir neste teste',
          'Reset test setup': 'Restaurar configuração de teste',
          'Add a temporary scenario': 'Adicionar cenário temporário',
          'Try a new behavior without changing the assistant configuration.': 'Teste um novo fluxo de atendimento sem alterar a configuração oficial do assistente.',
          'Add to test (↵)': 'Adicionar ao teste (↵)',
          'Add a temporary guideline': 'Adicionar diretriz temporária',
          'Test a response preference before adding it to the assistant.': 'Teste uma preferência de tom ou formatação antes de salvar no assistente.',
          'Add a temporary guardrail': 'Adicionar proteção temporária',
          'Test a safety boundary before adding it to the assistant.': 'Teste um limite de segurança antes de adicioná-lo ao assistente.',
          'Prospective Buyer': 'Qualificação de Novo Cliente (Exemplo)',
          'Handle customers who are showing interest in purchasing a license': 'Qualifica leads interessados em contratar planos ou agendar demonstração comercial.',
          'If someone is interested in purchasing a license, ask them for following:': 'Quando o cliente demonstrar interesse comercial, faça as seguintes perguntas:',
          'How many licenses are they willing to purchase?': 'Quantos especialistas utilizarão a plataforma no atendimento?',
          'Are they migrating from another platform?': 'Estão migrando de outra ferramenta ou iniciando a operação agora?',
          'Block queries that share or request sensitive personal information (e.g. phone numbers, passwords).': 'Bloquear solicitações que peçam ou exponham senhas, tokens ou dados sensíveis.',
          'Reject queries that include offensive, discriminatory, or threatening language.': 'Recusar interações com linguagem ofensiva, discriminatória ou inadequada.',
          'Deflect when the assistant is asked for legal or medical diagnosis or treatment.': 'Encaminhar ao especialista humano quando solicitado parecer jurídico, médico ou financeiro.'
        };

        var PLACEHOLDER_TRANSLATIONS = {
          'Paste or write new knowledge for this test': 'Cole ou digite um texto de referência para testar o assistente...',
          'Give your scenario a title': 'Dê um título ao cenário (ex: Triagem VIP)...',
          'Describe when this scenario should trigger': 'Descreva quando este cenário deve ser acionado...',
          'Write instructions for the assistant...': 'Escreva o passo a passo que o assistente deve seguir...'
        };

        function translateCaptainDOM(root) {
          if (!root) return;
          var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
          var node;
          while ((node = walker.nextNode())) {
            var raw = node.nodeValue;
            if (!raw) continue;
            var trimmed = raw.trim();
            if (!trimmed) continue;

            if (EXACT_TRANSLATIONS[trimmed]) {
              node.nodeValue = raw.replace(trimmed, EXACT_TRANSLATIONS[trimmed]);
            } else if (/^Existing scenarios \((\d+)\)$/.test(trimmed)) {
              var n1 = trimmed.match(/\d+/)[0];
              node.nodeValue = raw.replace(trimmed, 'Cenários ativos (' + n1 + ')');
            } else if (/^Existing guidelines \((\d+)\)$/.test(trimmed)) {
              var n2 = trimmed.match(/\d+/)[0];
              node.nodeValue = raw.replace(trimmed, 'Diretrizes ativas (' + n2 + ')');
            } else if (/^Existing guardrails \((\d+)\)$/.test(trimmed)) {
              var n3 = trimmed.match(/\d+/)[0];
              node.nodeValue = raw.replace(trimmed, 'Proteções ativas (' + n3 + ')');
            } else if (trimmed.indexOf('última atualização em há') !== -1) {
              node.nodeValue = raw.replace('última atualização em há', 'atualizado há');
            }
          }

          root.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(function(el) {
            var ph = el.getAttribute('placeholder');
            if (ph && PLACEHOLDER_TRANSLATIONS[ph]) {
              el.setAttribute('placeholder', PLACEHOLDER_TRANSLATIONS[ph]);
            }
          });
        }

        function syncCaptainModule() {
          if (isSyncing) return;
          isSyncing = true;
          try {
            var path = window.location.pathname || '';

            // Auto-redirect legacy /captain/assistants empty list to active Assistant #1 overview
            var mLegacy = path.match(/^\/app\/accounts\/(\d+)\/captain\/assistants\/?$/);
            if (mLegacy) {
              var targetOverview = '/app/accounts/' + mLegacy[1] + '/captain/1/overview';
              window.history.replaceState({}, '', targetOverview);
              window.dispatchEvent(new PopStateEvent('popstate'));
              return;
            }

            var m = path.match(/^\/app\/accounts\/(\d+)\/captain\/(?:(\d+)\/)?([^\/]+)/);
            var isCaptain = !!m;

            if (document.body.classList.contains('msc-captain-page') !== isCaptain) {
              document.body.classList.toggle('msc-captain-page', isCaptain);
            }

            if (!isCaptain) {
              var oldNav = document.getElementById('msc-captain-quicknav');
              if (oldNav) oldNav.remove();
              return;
            }

            var accId = m[1];
            var assistantId = m[2] || '1';
            var rawSection = m[3] || 'overview';
            var section = 'overview';
            if (rawSection.indexOf('faq') !== -1 || rawSection.indexOf('response') !== -1) section = 'faqs';
            else if (rawSection.indexOf('document') !== -1) section = 'documents';
            else if (rawSection.indexOf('scenario') !== -1) section = 'scenarios';
            else if (rawSection.indexOf('playground') !== -1) section = 'playground';
            else if (rawSection.indexOf('inbox') !== -1) section = 'inboxes';
            else if (rawSection.indexOf('tool') !== -1) section = 'tools';
            else if (rawSection.indexOf('setting') !== -1) section = 'settings';

            document.body.classList.toggle('msc-captain-scenarios-view', section === 'scenarios');
            var container = document.querySelector('section > main > div');
            if (container) {
              var bar = document.getElementById('msc-captain-quicknav');
              if (!bar) {
                bar = document.createElement('div');
                bar.id = 'msc-captain-quicknav';
                container.insertBefore(bar, container.firstChild);
              }
              var stateKey = accId + ':' + assistantId + ':' + section;
              if (bar.getAttribute('data-state') !== stateKey) {
                bar.setAttribute('data-state', stateKey);
                var tabs = [
                  { id: 'overview', label: 'Visão Geral', href: '/app/accounts/' + accId + '/captain/' + assistantId + '/overview' },
                  { id: 'faqs', label: 'FAQs (7)', href: '/app/accounts/' + accId + '/captain/' + assistantId + '/faqs' },
                  { id: 'documents', label: 'Documentos (6)', href: '/app/accounts/' + accId + '/captain/' + assistantId + '/documents' },
                  { id: 'scenarios', label: 'Cenários (4)', href: '/app/accounts/' + accId + '/captain/' + assistantId + '/scenarios' },
                  { id: 'playground', label: 'Playground', href: '/app/accounts/' + accId + '/captain/' + assistantId + '/playground' },
                  { id: 'inboxes', label: 'Canais (3)', href: '/app/accounts/' + accId + '/captain/' + assistantId + '/inboxes' },
                  { id: 'tools', label: 'Ferramentas API (3)', href: '/app/accounts/' + accId + '/captain/' + assistantId + '/tools' },
                  { id: 'settings', label: 'Configurações', href: '/app/accounts/' + accId + '/captain/' + assistantId + '/settings' }
                ];
                var tabsHtml = tabs.map(function(t) {
                  return '<a class="msc-cap-tab ' + (t.id === section ? 'active' : '') + '" data-nav="' + t.href + '" href="' + t.href + '">' + t.label + '</a>';
                }).join('');

                bar.innerHTML =
                  '<div class="msc-cap-tabs">' + tabsHtml + '</div>' +
                  '<div class="msc-cap-badge"><span class="msc-cap-badge-dot"></span><span>Gateway IA • gpt-5.6-sol Ativo</span></div>';

                bar.querySelectorAll('a[data-nav]').forEach(function(a) {
                  a.addEventListener('click', function(ev) {
                    ev.preventDefault();
                    var target = a.getAttribute('data-nav');
                    if (target && window.location.pathname !== target) {
                      window.history.pushState({}, '', target);
                      window.dispatchEvent(new PopStateEvent('popstate'));
                    }
                  });
                });
              }

              translateCaptainDOM(container);
            }
          } finally {
            isSyncing = false;
          }
        }

        function scheduleSync() {
          if (rafPending || isSyncing) return;
          rafPending = true;
          requestAnimationFrame(function() {
            rafPending = false;
            syncCaptainModule();
          });
        }

        var obs = new MutationObserver(scheduleSync);
        if (document.body) {
          obs.observe(document.body, { childList: true, subtree: true });
        } else {
          document.addEventListener('DOMContentLoaded', function() {
            obs.observe(document.body, { childList: true, subtree: true });
            syncCaptainModule();
          });
        }
        window.addEventListener('popstate', scheduleSync);
        syncCaptainModule();
      })();
    </script>
    <!-- END MSC CAPTAIN REFACTOR V1 -->
