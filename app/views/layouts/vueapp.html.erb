            }

            var accId = m[1];
            var portalSlug = (m[2] && !/^portals_/.test(m[2])) ? m[2] : 'central-de-ajuda';
            var locale = m[3] || 'pt_BR';
            var section = m[4] || m[5] || 'articles';

            var container = document.querySelector('section > main > .w-full.max-w-5xl.mx-auto, section > main > div');
            if (container) {
              var bar = document.getElementById('msc-hc-internal-bar');
              if (!bar) {
                bar = document.createElement('div');
                bar.id = 'msc-hc-internal-bar';
                container.insertBefore(bar, container.firstChild);
              }
              var stateKey = accId + ':' + portalSlug + ':' + locale + ':' + section;
              if (bar.getAttribute('data-state') !== stateKey) {
                bar.setAttribute('data-state', stateKey);
                bar.innerHTML =
                  '<div class="msc-hci-tabs">' +
                    '<a class="msc-hci-tab ' + (section === 'articles' ? 'active' : '') + '" data-nav="/app/accounts/' + accId + '/portals/' + portalSlug + '/' + locale + '/articles" href="/app/accounts/' + accId + '/portals/' + portalSlug + '/' + locale + '/articles">Artigos Publicados</a>' +
                    '<a class="msc-hci-tab ' + (section === 'categories' ? 'active' : '') + '" data-nav="/app/accounts/' + accId + '/portals/' + portalSlug + '/' + locale + '/categories" href="/app/accounts/' + accId + '/portals/' + portalSlug + '/' + locale + '/categories">Categorias</a>' +
                    '<a class="msc-hci-tab ' + (section === 'locales' ? 'active' : '') + '" data-nav="/app/accounts/' + accId + '/portals/' + portalSlug + '/locales" href="/app/accounts/' + accId + '/portals/' + portalSlug + '/locales">Localidades</a>' +
                    '<a class="msc-hci-tab ' + (section === 'settings' ? 'active' : '') + '" data-nav="/app/accounts/' + accId + '/portals/' + portalSlug + '/settings" href="/app/accounts/' + accId + '/portals/' + portalSlug + '/settings">Configurações</a>' +
                  '</div>' +
                  '<a class="msc-hci-public-btn" href="/hc/' + portalSlug + '/' + locale + '" target="_blank" rel="noopener noreferrer">' +
                    '<span>Abrir Portal Público (/hc/' + portalSlug + ') ↗</span>' +
                  '</a>';

                bar.querySelectorAll('a[data-nav]').forEach(function(a) {
                  a.addEventListener('click', function(ev) {
                    ev.preventDefault();
                    var target = a.getAttribute('data-nav');
                    if (target && window.location.pathname !== target) {
                      window.history.pushState({}, '', target);
                      window.dispatchEvent(new PopStateEvent('popstate'));
                    }
                  });
                });
              }

              // Fix "Visualização 295 de 295 visualizações" -> "295 visualizações"
              container.querySelectorAll('span').forEach(function(sp) {
                var txt = (sp.textContent || '').trim();
                var vm = txt.match(/^Visualização\s+(\d+)\s+de\s+\d+\s+visualizações$/i);
                if (vm) {
                  sp.textContent = vm[1] + ' visualizações';
                } else if (txt === 'Portuguese (Brazil)') {
                  sp.textContent = 'Português (Brasil)';
                } else if (/^artigos?\s+(\d+)$/i.test(txt)) {
                  var num = txt.match(/\d+/)[0];
                  sp.textContent = num + (num === '1' ? ' artigo' : ' artigos');
                }
              });
            }
          } finally {
            isSyncing = false;
          }
        }

        function scheduleSync() {
          if (rafPending || isSyncing) return;
          rafPending = true;
          requestAnimationFrame(function() {
            rafPending = false;
            syncPortalsInternal();
          });
        }

        var obs = new MutationObserver(scheduleSync);
        if (document.body) {
          obs.observe(document.body, { childList: true, subtree: true });
        } else {
          document.addEventListener('DOMContentLoaded', function() {
            obs.observe(document.body, { childList: true, subtree: true });
            syncPortalsInternal();
          });
        }
        window.addEventListener('popstate', scheduleSync);
        syncPortalsInternal();
      })();
    </script>
