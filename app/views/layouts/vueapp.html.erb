<!DOCTYPE html>
<html class="dark">
  <head>
    <title>
      <%= @global_config['INSTALLATION_NAME'] %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0"/>
    <% unless ChatwootApp.chatwoot_cloud? %>
      <meta name="robots" content="noindex">
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <script>
      try {
        localStorage.setItem('THEME_COLOR', 'dark');
        if (!localStorage.getItem('color_scheme')) {
          localStorage.setItem('color_scheme', 'dark');
        }
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      } catch (e) {}
    </script>
    <style id="meusuperchat-dark-emerald-theme">
      :root, html, html.dark, body {
        --brand: 16 185 129 !important;
        --b-50: 236 253 245 !important;
        --b-100: 209 250 229 !important;
        --b-200: 167 243 208 !important;
        --b-300: 110 231 183 !important;
        --b-400: 52 211 153 !important;
        --b-500: 16 185 129 !important;
        --b-600: 5 150 105 !important;
        --b-700: 4 120 87 !important;
        --b-800: 6 95 70 !important;
        --b-900: 6 78 59 !important;
        --w-25: #052e16 !important;
        --w-50: #064e3b !important;
        --w-75: #065f46 !important;
        --w-100: #047857 !important;
        --w-200: #059669 !important;
        --w-300: #10b981 !important;
        --w-400: #34d399 !important;
        --w-500: #10b981 !important;
        --w-600: #059669 !important;
        --w-700: #047857 !important;
        --w-800: #065f46 !important;
        --w-900: #064e3b !important;
      }
      html.dark body {
        background-color: #04080E !important;
        color: #f8fafc !important;
      }
      .text-n-brand {
        color: #10b981 !important;
      }
      .bg-n-brand {
        background-color: #10b981 !important;
      }
      .bg-n-brand:hover {
        background-color: #059669 !important;
      }
      .border-n-brand, .outline-n-brand, .ring-n-brand {
        border-color: #10b981 !important;
        --tw-ring-color: #10b981 !important;
      }

      /* ==========================================================================
         MEU SUPER CHAT — FUTURISTIC CLEAN LOGIN REIMAGINED (GPT 2.5 SPEC)
         ========================================================================== */
      body.msc-auth-page {
        background-color: #04080E !important;
        color: #F8FAFC !important;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
        overflow-x: hidden !important;
        min-height: 100vh !important;
        position: relative !important;
      }

      /* Ambient Futuristic Orbital & Horizon Glow Background */
      #msc-ambient-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
        background:
          radial-gradient(circle at 50% 18%, rgba(16, 185, 129, 0.14) 0%, rgba(0, 229, 179, 0.05) 32%, transparent 65%),
          radial-gradient(ellipse 90% 55% at 50% 100%, rgba(16, 185, 129, 0.22) 0%, rgba(6, 78, 59, 0.12) 45%, transparent 75%),
          #04080E;
      }
      #msc-ambient-bg .msc-orbit-1 {
        position: absolute;
        left: 50%;
        top: 52%;
        width: 980px;
        height: 980px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 1px solid rgba(16, 185, 129, 0.14);
        box-shadow: inset 0 0 80px rgba(16, 185, 129, 0.06), 0 0 60px rgba(16, 185, 129, 0.05);
      }
      #msc-ambient-bg .msc-orbit-2 {
        position: absolute;
        left: 50%;
        top: 46%;
        width: 680px;
        height: 680px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 1px solid rgba(45, 212, 191, 0.12);
        box-shadow: inset 0 0 50px rgba(0, 229, 179, 0.05);
      }
      #msc-ambient-bg .msc-horizon-arc {
        position: absolute;
        left: 50%;
        bottom: -440px;
        width: 1380px;
        height: 760px;
        transform: translateX(-50%);
        border-radius: 50%;
        border-top: 1.5px solid rgba(110, 231, 183, 0.42);
        background: radial-gradient(ellipse at 50% 0%, rgba(16, 185, 129, 0.20) 0%, rgba(4, 120, 87, 0.06) 45%, transparent 70%);
        box-shadow: 0 -20px 90px rgba(16, 185, 129, 0.28);
      }

      /* Main Auth Container Override */
      body.msc-auth-page #app,
      body.msc-auth-page #app > div {
        background: transparent !important;
        min-height: 100vh !important;
        position: relative;
        z-index: 10;
      }
      body.msc-auth-page main {
        background: transparent !important;
        min-height: 100vh !important;
        padding-top: 24px !important;
        padding-bottom: 24px !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
      }

      /* Stacked Futuristic Brand Logo + Heading */
      body.msc-auth-page main > section:first-child {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        margin-bottom: 4px !important;
      }
      body.msc-auth-page main > section:first-child img {
        height: 64px !important;
        width: auto !important;
        filter: drop-shadow(0 0 24px rgba(16, 185, 129, 0.35));
      }
      body.msc-auth-page main > section:first-child h2 {
        margin-top: 18px !important;
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif !important;
        font-size: 28px !important;
        font-weight: 700 !important;
        letter-spacing: -0.025em !important;
        color: #FFFFFF !important;
        text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
      }

      /* Elevated Dark Glassmorphism Login Card */
      body.msc-auth-page main > section:nth-of-type(2) {
        position: relative !important;
        width: calc(100% - 32px) !important;
        max-width: 440px !important;
        margin: 22px auto 0 auto !important;
        padding: 32px 32px !important;
        border-radius: 22px !important;
        background: rgba(11, 18, 30, 0.78) !important;
        border: 1px solid rgba(45, 212, 191, 0.24) !important;
        box-shadow:
          0 25px 60px -12px rgba(0, 0, 0, 0.85),
          0 0 45px -10px rgba(16, 185, 129, 0.25),
          inset 0 1px 1px rgba(255, 255, 255, 0.12) !important;
        backdrop-filter: blur(24px) !important;
        -webkit-backdrop-filter: blur(24px) !important;
      }
      /* Specular Top & Bottom Neon Highlights on Card */
      body.msc-auth-page main > section:nth-of-type(2)::before {
        content: "";
        position: absolute;
        top: -1px;
        left: 15%;
        right: 15%;
        height: 1.5px;
        background: linear-gradient(90deg, transparent, rgba(45, 212, 191, 0.95), rgba(212, 255, 0, 0.75), transparent);
        box-shadow: 0 0 16px 2px rgba(16, 185, 129, 0.55);
        pointer-events: none;
      }
      body.msc-auth-page main > section:nth-of-type(2)::after {
        content: "";
        position: absolute;
        bottom: -1px;
        left: 20%;
        right: 20%;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.95), rgba(212, 255, 0, 0.8), transparent);
        box-shadow: 0 0 24px 4px rgba(16, 185, 129, 0.65);
        pointer-events: none;
      }

      /* Hide SSO Login Button & "OU" Divider (Email & Password Only) */
      body.msc-auth-page a[href*="/login/sso"],
      body.msc-auth-page .section-separator,
      body.msc-auth-page main > section:nth-of-type(2) > div:has(a[href*="/login/sso"]) {
        display: none !important;
      }

      /* Form Labels */
      body.msc-auth-page form label {
        color: #E2E8F0 !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        margin-bottom: 6px !important;
      }

      /* Dark Glass Inputs (Email & Password) + Autofill Override */
      body.msc-auth-page input[data-testid="email_input"],
      body.msc-auth-page input[data-testid="password_input"],
      body.msc-auth-page form input[type="text"],
      body.msc-auth-page form input[type="email"],
      body.msc-auth-page form input[type="password"] {
        height: 46px !important;
        padding-left: 42px !important;
        padding-right: 40px !important;
        border-radius: 12px !important;
        background-color: rgba(16, 25, 41, 0.88) !important;
        border: 1px solid rgba(255, 255, 255, 0.11) !important;
        outline: none !important;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35) !important;
        color: #F8FAFC !important;
        font-size: 14px !important;
        transition: all 0.2s ease !important;
      }
      body.msc-auth-page input[data-testid="email_input"]::placeholder,
      body.msc-auth-page input[data-testid="password_input"]::placeholder {
        color: #64748B !important;
      }
      body.msc-auth-page input[data-testid="email_input"]:focus,
      body.msc-auth-page input[data-testid="password_input"]:focus {
        background-color: rgba(19, 31, 51, 0.95) !important;
        border-color: #10B981 !important;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.20), inset 0 1px 2px rgba(0, 0, 0, 0.3) !important;
      }
      body.msc-auth-page input:-webkit-autofill,
      body.msc-auth-page input:-webkit-autofill:hover,
      body.msc-auth-page input:-webkit-autofill:focus {
        -webkit-text-fill-color: #F8FAFC !important;
        -webkit-box-shadow: 0 0 0px 1000px #101929 inset !important;
        border: 1px solid rgba(45, 212, 191, 0.35) !important;
        transition: background-color 5000s ease-in-out 0s;
      }

      /* Left Field Icons inside Inputs */
      .msc-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 17px;
        height: 17px;
        color: #94A3B8;
        pointer-events: none;
        z-index: 5;
      }

      /* Forgot Password Link ("Esqueceu-se da sua senha?") */
      body.msc-auth-page a[href*="reset/password"] {
        color: #00E5B3 !important;
        font-size: 12px !important;
        font-weight: 500 !important;
        text-decoration: underline !important;
        text-underline-offset: 4px !important;
        text-decoration-color: rgba(0, 229, 179, 0.45) !important;
        transition: color 0.2s ease !important;
      }
      body.msc-auth-page a[href*="reset/password"]:hover {
        color: #D4FF00 !important;
        text-decoration-color: #D4FF00 !important;
      }
      .msc-forgot-wrap {
        display: flex;
        justify-content: flex-end;
        margin-top: 8px !important;
      }

      /* Primary Submit Button ("Entrar ->") */
      body.msc-auth-page button[data-testid="submit_button"] {
        height: 48px !important;
        border-radius: 12px !important;
        background: linear-gradient(90deg, #00D68F 0%, #4ADE80 52%, #D4FF00 100%) !important;
        color: #04120B !important;
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif !important;
        font-size: 16px !important;
        font-weight: 700 !important;
        letter-spacing: -0.01em !important;
        border: none !important;
        outline: none !important;
        box-shadow: 0 0 28px rgba(16, 185, 129, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.35) !important;
        transition: all 0.2s ease !important;
      }
      body.msc-auth-page button[data-testid="submit_button"]:hover {
        filter: brightness(1.08) !important;
        box-shadow: 0 0 36px rgba(212, 255, 0, 0.48) !important;
        transform: translateY(-1px);
      }
      body.msc-auth-page button[data-testid="submit_button"] span {
        color: #04120B !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
      }
      body.msc-auth-page button[data-testid="submit_button"] span::after {
        content: "→";
        font-size: 18px;
        line-height: 1;
        font-weight: 700;
        transition: transform 0.2s ease;
      }
      body.msc-auth-page button[data-testid="submit_button"]:hover span::after {
        transform: translateX(3px);
      }

      /* Responsive Adjustments (Tablet & Mobile) */
      @media (max-width: 480px) {
        body.msc-auth-page main > section:first-child h2 {
          font-size: 22px !important;
        }
        body.msc-auth-page main > section:nth-of-type(2) {
          padding: 24px 20px !important;
        }
      }

      /* ==========================================================================
         MEU SUPER CHAT — DASHBOARD DARK GLASSMORPHISM (GPT 2.5 SPEC)
         Escopo: body.msc-app-page (todas as telas logadas). Menu real preservado.
         ========================================================================== */
      body.msc-app-page,
      body.msc-app-page #app > div.bg-n-background {
        background-color: #04080E !important;
      }

      /* --- Sidebar (coluna 1) --- */
      body.msc-app-page aside.bg-n-background {
        background: linear-gradient(180deg, #070E17 0%, #050A11 100%) !important;
        border-color: rgba(255, 255, 255, 0.07) !important;
      }
      body.msc-app-page aside #sidebar-account-switcher span {
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif !important;
        font-weight: 700 !important;
        color: #F8FAFC !important;
      }
      body.msc-app-page aside a[href$="/search"] {
        background: rgba(255, 255, 255, 0.03) !important;
        outline-color: rgba(255, 255, 255, 0.08) !important;
        border-radius: 10px !important;
        transition: outline-color 0.2s ease, background 0.2s ease !important;
      }
      body.msc-app-page aside a[href$="/search"]:hover {
        outline-color: rgba(16, 185, 129, 0.40) !important;
        background: rgba(16, 185, 129, 0.06) !important;
      }
      body.msc-app-page aside section button:has(.i-lucide-pen-line) {
        background: rgba(16, 185, 129, 0.15) !important;
        outline-color: rgba(16, 185, 129, 0.40) !important;
        color: #34D399 !important;
        border-radius: 10px !important;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.25) !important;
      }
      body.msc-app-page aside section button:has(.i-lucide-pen-line) span {
        color: #34D399 !important;
      }
      body.msc-app-page aside nav > ul > li > a {
        color: #94A3B8 !important;
        border-radius: 10px !important;
        transition: background 0.18s ease, color 0.18s ease !important;
      }
      body.msc-app-page aside nav > ul > li > a:hover {
        background: rgba(255, 255, 255, 0.04) !important;
        color: #F8FAFC !important;
      }
      body.msc-app-page aside nav > ul > li > a.font-medium {
        color: #F8FAFC !important;
      }
      body.msc-app-page aside nav > ul > li > a.font-medium [class*="i-lucide"] {
        color: #34D399 !important;
      }
      /* Grupo expandido (ex.: Conversas) em container sutil */
      body.msc-app-page aside nav > ul > li:has(> ul li a.router-link-active) {
        border-radius: 12px !important;
        border: 1px solid rgba(16, 185, 129, 0.20) !important;
        background: rgba(6, 78, 59, 0.10) !important;
        padding: 2px 0 6px !important;
      }
      body.msc-app-page aside li.child-item {
        margin-inline-start: 8px !important;
        padding-inline-start: 6px !important;
      }
      body.msc-app-page aside li.child-item::before {
        background-color: rgba(16, 185, 129, 0.18) !important;
      }
      body.msc-app-page aside li.child-item::after {
        background-color: transparent !important;
        border-color: rgba(16, 185, 129, 0.18) !important;
      }
      body.msc-app-page aside li.child-item > a {
        padding-left: 6px !important;
        padding-right: 6px !important;
      }
      /* Item ativo: gradiente emerald + barra Volt Lime + sem truncar */
      body.msc-app-page aside li.child-item a.router-link-active,
      body.msc-app-page aside li.child-item a.active {
        position: relative !important;
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.25) 0%, rgba(16, 185, 129, 0.05) 100%) !important;
        box-shadow: inset 0 0 0 1px rgba(16, 185, 129, 0.30), 0 0 15px rgba(16, 185, 129, 0.15) !important;
        color: #FFFFFF !important;
        font-weight: 600 !important;
      }
      body.msc-app-page aside li.child-item a.router-link-active::before,
      body.msc-app-page aside li.child-item a.active::before {
        content: "";
        position: absolute;
        left: -3px;
        top: 7px;
        bottom: 7px;
        width: 3px;
        border-radius: 0 4px 4px 0;
        background: #D4FF00;
        box-shadow: 0 0 8px #D4FF00;
      }
      body.msc-app-page aside li.child-item a.router-link-active [class*="i-lucide"] {
        color: #34D399 !important;
      }
      body.msc-app-page aside li.child-item a.router-link-active .truncate {
        overflow: visible !important;
        text-overflow: clip !important;
        white-space: nowrap !important;
        font-size: 13px !important;
        letter-spacing: -0.015em;
      }
      body.msc-app-page aside li.child-item a:not(.router-link-active):hover {
        background: rgba(255, 255, 255, 0.04) !important;
        color: #F8FAFC !important;
      }

      /* --- Lista de conversas (coluna 2) --- */
      body.msc-app-page .conversations-list-wrap {
        background: rgba(7, 14, 23, 0.92) !important;
        border-right: 1px solid rgba(255, 255, 255, 0.07) !important;
      }
      body.msc-app-page .conversations-list-wrap h1 {
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif !important;
        font-size: 18px !important;
        font-weight: 700 !important;
        letter-spacing: -0.02em !important;
        color: #F8FAFC !important;
      }
      body.msc-app-page .conversations-list-wrap h1 + span,
      body.msc-app-page .conversations-list-wrap h1 ~ span.capitalize {
        background: rgba(16, 185, 129, 0.15) !important;
        border: 1px solid rgba(16, 185, 129, 0.30) !important;
        color: #34D399 !important;
        border-radius: 999px !important;
        font-weight: 600 !important;
        padding: 2px 10px !important;
      }
      body.msc-app-page .conversations-list-wrap > div:first-child button {
        background: rgba(255, 255, 255, 0.04) !important;
        outline: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 8px !important;
      }
      body.msc-app-page .conversations-list-wrap > div:first-child button:hover {
        outline-color: rgba(16, 185, 129, 0.40) !important;
        color: #34D399 !important;
      }
      body.msc-app-page .conversations-list-wrap .border-b-n-weak {
        border-bottom-color: rgba(255, 255, 255, 0.07) !important;
      }
      /* Abas: ativa em Emerald (antes laranja/azul) */
      body.msc-app-page .conversations-list-wrap ul li a.text-n-blue-11 {
        color: #FFFFFF !important;
        font-weight: 600 !important;
      }
      body.msc-app-page .conversations-list-wrap ul li a.text-n-blue-11::after {
        background: #34D399 !important;
        box-shadow: 0 0 10px rgba(52, 211, 153, 0.75) !important;
      }
      body.msc-app-page .conversations-list-wrap ul li a.text-n-blue-11 > div {
        background: rgba(16, 185, 129, 0.20) !important;
        color: #6EE7B7 !important;
        border: 1px solid rgba(16, 185, 129, 0.30) !important;
      }
      body.msc-app-page .conversations-list-wrap ul li a.text-n-slate-11 > div {
        background: rgba(255, 255, 255, 0.05) !important;
        color: #94A3B8 !important;
      }
      /* Empty state ilustrado */
      body.msc-app-page .conversations-list-wrap > p.msc-empty-enhanced {
        flex: 1 1 auto !important;
        flex-direction: column !important;
        text-align: center !important;
        padding: 32px 28px !important;
        color: #E2E8F0 !important;
        font-size: 15px !important;
        font-weight: 600 !important;
      }
      body.msc-app-page .conversations-list-wrap > p.msc-empty-enhanced ~ .conversations-list {
        flex: 0 0 auto !important;
      }
      .msc-empty-icon {
        position: relative;
        width: 92px;
        height: 92px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748B;
        box-shadow: 0 0 40px rgba(16, 185, 129, 0.14), inset 0 0 20px rgba(16, 185, 129, 0.06);
      }
      .msc-empty-icon svg { width: 38px; height: 38px; }
      .msc-empty-sub {
        display: block;
        max-width: 250px;
        margin: 8px auto 0;
        color: #64748B;
        font-size: 12.5px;
        font-weight: 400;
        line-height: 1.6;
      }

      /* --- Área principal: onboarding (coluna 3) --- */
      body.msc-app-page .conversation-details-wrap {
        position: relative !important;
        background: #04080E !important;
        border-color: rgba(255, 255, 255, 0.07) !important;
        overflow: hidden;
      }
      body.msc-app-page .conversation-details-wrap::before {
        content: "";
        position: absolute;
        top: -120px;
        right: -80px;
        width: 560px;
        height: 340px;
        background: radial-gradient(ellipse at 70% 30%, rgba(16, 185, 129, 0.20) 0%, rgba(212, 255, 0, 0.05) 40%, transparent 70%);
        filter: blur(30px);
        pointer-events: none;
        z-index: 0;
      }
      body.msc-app-page .msc-onboarding {
        position: relative;
        z-index: 1;
        gap: 20px !important;
      }
      body.msc-app-page .msc-onboarding > .col-span-full p:first-child {
        font-family: 'Plus Jakarta Sans', 'Inter', 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif !important;
        font-size: 26px !important;
        font-weight: 700 !important;
        letter-spacing: -0.02em !important;
        line-height: 1.3 !important;
        color: #F8FAFC !important;
      }
      body.msc-app-page .msc-onboarding > .col-span-full p:nth-child(2) {
        margin-top: 6px !important;
        font-size: 15px !important;
        color: #94A3B8 !important;
      }
      body.msc-app-page .msc-onboarding > div.rounded-lg {
        position: relative !important;
        overflow: hidden !important;
        min-height: 270px !important;
        padding: 22px !important;
        border-radius: 18px !important;
        background: rgba(11, 22, 34, 0.62) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.40), inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease !important;
      }
      body.msc-app-page .msc-onboarding > div.rounded-lg:hover {
        border-color: rgba(16, 185, 129, 0.32) !important;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(16, 185, 129, 0.12) !important;
        transform: translateY(-2px);
      }
      body.msc-app-page .msc-onboarding > div.rounded-lg > .flex-1 img {
        display: none !important;
      }
      body.msc-app-page .msc-onboarding > div.rounded-lg p.font-semibold {
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif !important;
        font-size: 17px !important;
        color: #FFFFFF !important;
        margin-bottom: 4px !important;
      }
      body.msc-app-page .msc-onboarding > div.rounded-lg p.text-sm {
        font-size: 13.5px !important;
        line-height: 1.6 !important;
        color: #94A3B8 !important;
      }
      /* CTA pill */
      body.msc-app-page .msc-onboarding > div.rounded-lg a.text-n-brand {
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
        margin-top: 14px !important;
        padding: 8px 16px !important;
        border-radius: 999px !important;
        background: rgba(16, 185, 129, 0.15) !important;
        border: 1px solid rgba(16, 185, 129, 0.40) !important;
        color: #FFFFFF !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.20) !important;
        transition: all 0.2s ease !important;
      }
      body.msc-app-page .msc-onboarding > div.rounded-lg a.text-n-brand:hover {
        background: rgba(16, 185, 129, 0.25) !important;
        box-shadow: 0 0 26px rgba(16, 185, 129, 0.40) !important;
      }
      body.msc-app-page .msc-onboarding > div.rounded-lg a.text-n-brand span.ml-2 {
        margin-left: 0 !important;
        color: #34D399 !important;
        transition: transform 0.2s ease;
      }
      body.msc-app-page .msc-onboarding > div.rounded-lg a.text-n-brand:hover span.ml-2 {
        transform: translateX(3px);
      }
      /* Visuais glass (substituem PNGs brancos) */
      .msc-visual {
        position: relative;
        width: 100%;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
      }
      .msc-glass-tile {
        position: relative;
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.45), 0 0 18px rgba(16, 185, 129, 0.12);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .msc-glass-tile svg { width: 28px; height: 28px; }
      .msc-glass-tile:nth-child(odd) { transform: rotate(-6deg) translateY(-6px); }
      .msc-glass-tile:nth-child(even) { transform: rotate(6deg) translateY(6px); }
      .msc-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        min-width: 20px;
        padding: 1px 6px;
        border-radius: 999px;
        background: #EF4444;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        line-height: 18px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.45);
      }
      .msc-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        font-weight: 700;
        font-size: 15px;
        color: #04120B;
        box-shadow: 0 0 0 2px #34D399, 0 0 15px rgba(16, 185, 129, 0.45);
        margin-left: -10px;
      }
      .msc-avatar:first-child { margin-left: 0; }
      .msc-avatar-add {
        width: 48px;
        height: 48px;
        margin-left: 8px;
        border-radius: 50%;
        border: 1.5px dashed rgba(16, 185, 129, 0.5);
        color: #34D399;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 300;
      }
      .msc-cursor { position: absolute; width: 22px; height: 22px; filter: drop-shadow(0 0 6px currentColor); }
      .msc-cmd {
        width: 100%;
        max-width: 330px;
        border-radius: 12px;
        background: rgba(6, 13, 22, 0.92);
        border: 1px solid rgba(16, 185, 129, 0.30);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        font-size: 12px;
        text-align: left;
      }
      .msc-cmd-input { padding: 8px 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); color: #fff; font-family: ui-monospace, monospace; }
      .msc-cmd-input i { color: #34D399; font-style: normal; animation: mscBlink 1s steps(1) infinite; }
      .msc-cmd-row { display: flex; justify-content: space-between; gap: 10px; padding: 6px 10px; margin: 4px; border-radius: 8px; color: #94A3B8; }
      .msc-cmd-row b { font-family: ui-monospace, monospace; font-weight: 600; }
      .msc-cmd-row span { color: #64748B; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .msc-cmd-row.on { background: rgba(16, 185, 129, 0.20); border: 1px solid rgba(16, 185, 129, 0.30); color: #6EE7B7; }
      .msc-cmd-row.on span { color: #CBD5E1; }
      @keyframes mscBlink { 50% { opacity: 0; } }
      .msc-tags { flex-wrap: wrap; gap: 10px 12px; max-width: 300px; }
      .msc-tag {
        padding: 7px 14px;
        border-radius: 12px;
        border: 1px solid;
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        font-weight: 700;
        font-size: 15px;
      }
      .msc-tag.t1 { background: rgba(16,185,129,.15); border-color: rgba(52,211,153,.5); color: #6EE7B7; box-shadow: 0 0 15px rgba(16,185,129,.22); transform: rotate(-4deg); }
      .msc-tag.t2 { background: rgba(212,255,0,.12); border-color: rgba(212,255,0,.5); color: #D4FF00; box-shadow: 0 0 15px rgba(212,255,0,.2); transform: rotate(3deg); }
      .msc-tag.t3 { background: rgba(59,130,246,.15); border-color: rgba(96,165,250,.5); color: #93C5FD; box-shadow: 0 0 15px rgba(59,130,246,.2); transform: rotate(2deg); }
      .msc-tag.t4 { background: rgba(168,85,247,.15); border-color: rgba(192,132,252,.5); color: #D8B4FE; box-shadow: 0 0 15px rgba(168,85,247,.2); transform: rotate(-3deg); }

      /* Responsivo: cards em 1 coluna abaixo de 1100px na área útil */
      @media (max-width: 1180px) {
        body.msc-app-page .msc-onboarding {
          grid-template-columns: minmax(0, 1fr) !important;
          grid-template-rows: auto !important;
          padding: 24px !important;
        }
      }
      @media (max-width: 768px) {
        body.msc-app-page .msc-onboarding > .col-span-full p:first-child { font-size: 21px !important; }
        body.msc-app-page .msc-onboarding { padding: 18px !important; }
        body.msc-app-page .msc-onboarding > div.rounded-lg { min-height: 0 !important; }
        .msc-visual { height: 120px; }
      }
    </style>
