<!DOCTYPE html>
<html>
  <head>
    <title>
      <%= @global_config['INSTALLATION_NAME'] %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0"/>
    <% unless ChatwootApp.chatwoot_cloud? %>
      <meta name="robots" content="noindex">
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
      try {
        var rawScheme = localStorage.getItem('color_scheme') || 'dark';
        var cleanScheme = rawScheme.replace(/^"|"$/g, '');
        if (!localStorage.getItem('color_scheme')) {
          localStorage.setItem('color_scheme', '"dark"');
          cleanScheme = 'dark';
        }
        var isOSDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var useDark = (cleanScheme === 'dark') || (cleanScheme === 'auto' && isOSDark);
        if (useDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
          document.documentElement.style.setProperty('color-scheme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
          document.documentElement.style.setProperty('color-scheme', 'light');
        }
      } catch (e) {}
    </script>
    <style id="meusuperchat-dark-emerald-theme">
      :root, html, body {
        --brand: 16 185 129 !important;
        --b-50: 236 253 245 !important;
        --b-100: 209 250 229 !important;
        --b-200: 167 243 208 !important;
        --b-300: 110 231 183 !important;
        --b-400: 52 211 153 !important;
        --b-500: 16 185 129 !important;
        --b-600: 5 150 105 !important;
        --b-700: 4 120 87 !important;
        --b-800: 6 95 70 !important;
        --b-900: 6 78 59 !important;
        --w-25: #f0fdf4 !important;
        --w-50: #ecfdf5 !important;
        --w-75: #d1fae5 !important;
        --w-100: #a7f3d0 !important;
        --w-200: #6ee7b7 !important;
