  <body class="text-slate-700 bg-[#F8FAFC] dark:bg-[#04080E] dark:text-slate-100">
    <script>
      (function() {
        try {
          if (document.documentElement.classList.contains('dark')) {
            document.body.classList.add('dark');
            document.body.classList.remove('light');
          } else {
            document.body.classList.remove('dark');
            document.body.classList.add('light');
          }
        } catch (e) {}
        function enhanceLoginView() {
          var isAuth = window.location.pathname.indexOf('/login') !== -1 || window.location.pathname.indexOf('/auth') !== -1;
          if (!isAuth) {
            document.body.classList.remove('msc-auth-page');
            var oldBar = document.getElementById('msc-top-bar');
            if (oldBar) oldBar.remove();
            var oldBg = document.getElementById('msc-ambient-bg');
            if (oldBg) oldBg.remove();
            return;
          }

          document.body.classList.add('msc-auth-page');

          // Force dark class on Vue root wrapper
          var appRoot = document.querySelector('#app > div');
          if (appRoot && appRoot.classList.contains('light')) {
            appRoot.classList.remove('light');
            appRoot.classList.add('dark');
          }

          // Inject Ambient Background
          if (!document.getElementById('msc-ambient-bg')) {
            var bg = document.createElement('div');
            bg.id = 'msc-ambient-bg';
            bg.innerHTML = '<div class="msc-orbit-1"></div><div class="msc-orbit-2"></div><div class="msc-horizon-arc"></div>';
            document.body.insertBefore(bg, document.body.firstChild);
          }

          // Ensure any legacy top bar is removed
          var oldTopBar = document.getElementById('msc-top-bar');
          if (oldTopBar) oldTopBar.remove();

          // Inject Stacked Glowing Logo (matching GPT 2.5 mockup)
          var firstSection = document.querySelector('main > section:first-child');
          if (firstSection && !document.getElementById('msc-hero-logo')) {
            var imgs = firstSection.querySelectorAll('img');
            imgs.forEach(function(img) { img.style.display = 'none'; });
            var logoWrap = document.createElement('div');
            logoWrap.id = 'msc-hero-logo';
            logoWrap.innerHTML =
              '<svg width="250" height="76" viewBox="0 0 340 104" fill="none" xmlns="http://www.w3.org/2000/svg" style="filter: drop-shadow(0 0 24px rgba(16, 185, 129, 0.35));">' +
                '<defs>' +
                  '<linearGradient id="mscBubbleGrad" x1="10" y1="10" x2="90" y2="90" gradientUnits="userSpaceOnUse">' +
                    '<stop offset="0%" stop-color="#D4FF00"/>' +
                    '<stop offset="55%" stop-color="#4ADE80"/>' +
                    '<stop offset="100%" stop-color="#10B981"/>' +
                  '</linearGradient>' +
                '</defs>' +
                '<rect x="14" y="10" width="76" height="72" rx="24" fill="rgba(16, 185, 129, 0.10)" stroke="url(#mscBubbleGrad)" stroke-width="4.5"/>' +
                '<path d="M36 82L26 95L48 82" fill="rgba(16, 185, 129, 0.10)" stroke="url(#mscBubbleGrad)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>' +
                '<path d="M56 26L41 47H52L47 66L63 45H52L56 26Z" fill="#D4FF00"/>' +
                '<text x="108" y="48" font-family="Plus Jakarta Sans, Inter, sans-serif" font-size="40" font-weight="800" letter-spacing="-0.03em" fill="#FFFFFF">meusuper</text>' +
                '<text x="108" y="86" font-family="Plus Jakarta Sans, Inter, sans-serif" font-size="42" font-weight="800" letter-spacing="-0.03em" fill="#B8FF01">chat</text>' +
                '<text x="202" y="68" font-family="Inter, sans-serif" font-size="12" font-weight="700" fill="#94A3B8">®</text>' +
              '</svg>';
            firstSection.insertBefore(logoWrap, firstSection.firstChild);
          }

          // Inject Icons inside Email and Password inputs + Move Forgot Password Link below Password Input
          var emailInput = document.querySelector('input[data-testid="email_input"]');
          if (emailInput && emailInput.parentElement && !emailInput.parentElement.querySelector('.msc-input-icon')) {
            var mailIcon = document.createElement('span');
            mailIcon.className = 'msc-input-icon';
            mailIcon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';
            emailInput.parentElement.insertBefore(mailIcon, emailInput);
          }

          var passInput = document.querySelector('input[data-testid="password_input"]');
          if (passInput && passInput.parentElement && !passInput.parentElement.querySelector('.msc-input-icon')) {
            var lockIcon = document.createElement('span');
            lockIcon.className = 'msc-input-icon';
            lockIcon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>';
            passInput.parentElement.insertBefore(lockIcon, passInput);
          }

          var forgotLink = document.querySelector('a[href*="reset/password"]');
          if (forgotLink && passInput) {
            var fieldContainer = passInput.closest('.space-y-1');
            if (fieldContainer && !fieldContainer.querySelector('.msc-forgot-wrap')) {
              var wrap = document.createElement('div');
              wrap.className = 'msc-forgot-wrap';
              wrap.appendChild(forgotLink);
              fieldContainer.appendChild(wrap);
            }
          }
        }

        var MSC_ICONS = {
          whatsapp: '<svg viewBox="0 0 24 24" fill="#25D366"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.6-.1 1.1Z"/></svg>',
          messenger: '<svg viewBox="0 0 24 24"><defs><linearGradient id="mscMsg" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#0866FF"/><stop offset="1" stop-color="#C837AB"/></linearGradient></defs><path fill="url(#mscMsg)" d="M12 2C6.4 2 2 6.1 2 11.6c0 2.9 1.2 5.4 3.1 7.1V22l2.9-1.6c1.2.3 2.5.5 4 .5 5.6 0 10-4.1 10-9.6S17.6 2 12 2Z"/><path fill="#fff" d="m6.5 14.4 3-4.7 2.6 2 3.3-2.2-3 4.7-2.6-2Z"/></svg>',
          mail: '<svg viewBox="0 0 24 24" fill="none" stroke="#E2E8F0" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
          chat: '<svg viewBox="0 0 24 24" fill="#38BDF8"><path d="M12 3C6.5 3 2 6.8 2 11.5c0 2.3 1.1 4.4 2.9 6L4 21l4-1.8c1.2.4 2.6.6 4 .6 5.5 0 10-3.8 10-8.5S17.5 3 12 3Z"/><circle cx="8" cy="11.5" r="1.2" fill="#fff"/><circle cx="12" cy="11.5" r="1.2" fill="#fff"/><circle cx="16" cy="11.5" r="1.2" fill="#fff"/></svg>',
          cursor: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 3l16 7-7 2-2 7z"/></svg>'
        };

        function mscVisualFor(key) {
          if (key === 'inboxes') {
            return '<div class="msc-visual">' +
              '<div class="msc-glass-tile">' + MSC_ICONS.whatsapp + '<span class="msc-badge">12</span></div>' +
              '<div class="msc-glass-tile">' + MSC_ICONS.messenger + '<span class="msc-badge">3</span></div>' +
              '<div class="msc-glass-tile">' + MSC_ICONS.mail + '<span class="msc-badge">5</span></div>' +
              '<div class="msc-glass-tile">' + MSC_ICONS.chat + '<span class="msc-badge">8</span></div>' +
            '</div>';
          }
          if (key === 'teams') {
            return '<div class="msc-visual" style="gap:0">' +
              '<div class="msc-avatar" style="background:linear-gradient(135deg,#6EE7B7,#10B981)">AN</div>' +
              '<div class="msc-avatar" style="background:linear-gradient(135deg,#D4FF00,#4ADE80)">RC</div>' +
              '<div class="msc-avatar" style="background:linear-gradient(135deg,#93C5FD,#34D399)">JS</div>' +
              '<div class="msc-avatar-add">+</div>' +
              '<span class="msc-cursor" style="color:#D4FF00;top:22px;left:24%">' + MSC_ICONS.cursor + '</span>' +
              '<span class="msc-cursor" style="color:#10B981;bottom:18px;right:22%;transform:scaleX(-1)">' + MSC_ICONS.cursor + '</span>' +
            '</div>';
          }
          if (key === 'canned') {
            return '<div class="msc-visual"><div class="msc-cmd">' +
              '<div class="msc-cmd-input">/g<i>|</i></div>' +
              '<div class="msc-cmd-row on"><b>/grato</b><span>Agradecimento ao cliente</span></div>' +
              '<div class="msc-cmd-row"><b>/garantia</b><span>Informações sobre garantia</span></div>' +
            '</div></div>';
          }
          if (key === 'labels') {
            return '<div class="msc-visual msc-tags">' +
              '<span class="msc-tag t1">#vendas</span><span class="msc-tag t2">#financeiro</span>' +
              '<span class="msc-tag t3">#suporte</span><span class="msc-tag t4">#vip</span>' +
            '</div>';
          }
          return '';
        }

        var MSC_CTA = {
          inboxes: 'Conectar canais agora',
          teams: 'Convidar agora',
          canned: 'Criar resposta pronta',
          labels: 'Criar etiquetas'
        };

        function mscKeyFromHref(href) {
          if (!href) return null;
          if (href.indexOf('/settings/inboxes') !== -1) return 'inboxes';
          if (href.indexOf('/settings/teams') !== -1 || href.indexOf('/settings/agents') !== -1) return 'teams';
          if (href.indexOf('/settings/canned-response') !== -1) return 'canned';
          if (href.indexOf('/settings/labels') !== -1) return 'labels';
          return null;
        }

        function enhanceAppView() {
          var path = window.location.pathname;
          var isAuth = path.indexOf('/login') !== -1 || path.indexOf('/auth') !== -1;
          if (isAuth || path.indexOf('/app') !== 0) {
            document.body.classList.remove('msc-app-page');
            return;
          }
          document.body.classList.add('msc-app-page');

          // Onboarding cards (tela inicial de Conversas)
          var details = document.querySelector('.conversation-details-wrap');
          if (details) {
            var grid = details.querySelector('.grid.grid-cols-2');
            if (grid && grid.querySelector('img[src*="/onboarding/"]')) {
              grid.classList.add('msc-onboarding');
              grid.querySelectorAll(':scope > div.rounded-lg').forEach(function(card) {
                var link = card.querySelector('a.text-n-brand');
                var key = mscKeyFromHref(link && link.getAttribute('href'));
                if (!key) return;
                var imgWrap = card.querySelector(':scope > .flex-1');
                if (imgWrap && !imgWrap.querySelector('.msc-visual')) {
                  imgWrap.insertAdjacentHTML('beforeend', mscVisualFor(key));
                }
                if (link && !link.dataset.mscCta) {
                  var label = link.querySelector('span:first-child');
                  if (label) label.textContent = MSC_CTA[key];
                  link.dataset.mscCta = '1';
                }
              });
            }
          }

          // Empty state ilustrado da lista de conversas
          var listWrap = document.querySelector('.conversations-list-wrap');
          if (listWrap) {
            var empty = listWrap.querySelector(':scope > p.justify-center');
            if (empty && !empty.querySelector('.msc-empty-icon')) {
              var msg = empty.textContent.trim();
              empty.classList.add('msc-empty-enhanced');
              empty.innerHTML =
                '<span class="msc-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.6A8 8 0 1 1 21 12Z"/><circle cx="8.5" cy="12" r=".6" fill="currentColor"/><circle cx="12.5" cy="12" r=".6" fill="currentColor"/><circle cx="16.5" cy="12" r=".6" fill="currentColor"/></svg></span>' +
                '<span class="msc-empty-title"></span>' +
                '<span class="msc-empty-sub">Quando novas conversas chegarem ou forem atribuídas a você, elas aparecerão aqui.</span>';
              empty.querySelector('.msc-empty-title').textContent = msg;
            }
          }
        }

        var mscQueued = false;
        function mscRunAll() {
          mscQueued = false;
          enhanceLoginView();
          enhanceAppView();
        }

        document.addEventListener('DOMContentLoaded', function() {
          mscRunAll();
          var obs = new MutationObserver(function() {
            if (mscQueued) return;
            mscQueued = true;
            window.requestAnimationFrame(mscRunAll);
          });
          obs.observe(document.body, { childList: true, subtree: true });
        });
      })();
    </script>
