        --solid-3: 241 245 249 !important;
        --solid-active: 209 250 229 !important;
        --card-color: 255 255 255 !important;
        --button-color: 255 255 255 !important;
        --label-background: 241 245 249 !important;

        /* Clean Light Slate Scale (1 = lightest, 12 = darkest text) */
        --slate-1: 255 255 255 !important;
        --slate-2: 248 250 252 !important;
        --slate-3: 241 245 249 !important;
        --slate-4: 226 232 240 !important;
        --slate-5: 203 213 225 !important;
        --slate-6: 148 163 184 !important;
        --slate-7: 100 116 139 !important;
        --slate-8: 71 85 105 !important;
        --slate-9: 71 85 105 !important;
        --slate-10: 51 65 85 !important;
        --slate-11: 30 41 59 !important;
        --slate-12: 15 23 42 !important;

        /* Emerald Brand Scale replacing --blue-* in Light Mode */
        --blue-1: 240 253 244 !important;
        --blue-2: 236 253 245 !important;
        --blue-3: 209 250 229 !important;
        --blue-4: 167 243 208 !important;
        --blue-5: 110 231 183 !important;
        --blue-6: 52 211 153 !important;
        --blue-7: 16 185 129 !important;
        --blue-8: 5 150 105 !important;
        --blue-9: 16 185 129 !important;
        --blue-10: 5 150 105 !important;
        --blue-11: 4 120 87 !important;
        --blue-12: 6 78 59 !important;
        --text-blue: 4 120 87 !important;
        --border-blue: 16, 185, 129, 0.38 !important;
        --border-blue-strong: 5 150 105 !important;
        --solid-blue: 209 250 229 !important;
        --solid-blue-2: 236 253 245 !important;

        --border-weak: 226 232 240 !important;
        --border-strong: 203 213 225 !important;
        --border-container: 226 232 240 !important;
        --alpha-1: 15, 23, 42, 0.04 !important;
        --alpha-2: 16, 185, 129, 0.10 !important;
        --alpha-3: 255, 255, 255, 0.96 !important;
        --black-alpha-1: 15, 23, 42, 0.08 !important;
        --black-alpha-2: 15, 23, 42, 0.04 !important;
      }

      /* ==========================================================================
         DARK MODE (OBSIDIAN & EMERALD) TOKENS — html.dark / body.dark / .dark
         ========================================================================== */
      html.dark, body.dark, .dark {
        --w-25: #052e16 !important;
        --w-50: #064e3b !important;
        --w-75: #065f46 !important;
        --w-100: #047857 !important;
        --w-200: #059669 !important;
        --w-300: #10b981 !important;
        --w-400: #34d399 !important;
        --w-500: #10b981 !important;
        --w-600: #059669 !important;
        --w-700: #047857 !important;
        --w-800: #065f46 !important;
        --w-900: #064e3b !important;

        /* Global Obsidian & Emerald Dark Surface Tokens */
        --background-color: 4 8 14 !important;
        --surface-1: 4 8 14 !important;
        --surface-2: 7 14 23 !important;
        --surface-active: 14 28 44 !important;
        --solid-1: 8 15 26 !important;
        --solid-2: 11 22 34 !important;
        --solid-3: 16 30 46 !important;
        --solid-active: 20 38 58 !important;
        --card-color: 9 18 29 !important;
        --button-color: 13 25 40 !important;
        --label-background: 11 22 34 !important;

        /* Cool Obsidian Slate Scale */
        --slate-1: 4 8 14 !important;
        --slate-2: 7 14 23 !important;
        --slate-3: 11 22 34 !important;
        --slate-4: 15 29 44 !important;
        --slate-5: 22 38 56 !important;
        --slate-6: 30 49 70 !important;
        --slate-7: 45 66 90 !important;
        --slate-8: 71 85 105 !important;
        --slate-9: 100 116 139 !important;
        --slate-10: 148 163 184 !important;
        --slate-11: 203 213 225 !important;
        --slate-12: 248 250 252 !important;

        /* Replace orange --blue-* tokens with Emerald/Mint scale globally */
        --blue-1: 4 15 12 !important;
        --blue-2: 6 24 19 !important;
        --blue-3: 6 46 34 !important;
        --blue-4: 6 62 46 !important;
        --blue-5: 6 78 59 !important;
        --blue-6: 5 105 78 !important;
        --blue-7: 4 120 87 !important;
        --blue-8: 5 150 105 !important;
        --blue-9: 16 185 129 !important;
        --blue-10: 52 211 153 !important;
        --blue-11: 110 231 183 !important;
        --blue-12: 209 250 229 !important;
        --text-blue: 167 243 208 !important;
        --border-blue: 16, 185, 129, 0.45 !important;
        --border-blue-strong: 5 150 105 !important;
        --solid-blue: 6 62 46 !important;
        --solid-blue-2: 6 28 22 !important;

        /* Borders & Alphas in Cool Deep Glass */
        --border-weak: 18 32 48 !important;
        --border-strong: 28 46 68 !important;
        --alpha-1: 11, 22, 34, 0.82 !important;
        --alpha-2: 148, 163, 184, 0.10 !important;
        --alpha-3: 7, 14, 23, 0.95 !important;
        --black-alpha-1: 2, 6, 12, 0.45 !important;
        --black-alpha-2: 7, 14, 23, 0.65 !important;
      }
      html.dark body {
        background-color: #04080E !important;
        color: #f8fafc !important;
      }
      .text-n-brand {
        color: #10b981 !important;
      }
      .bg-n-brand {
        background-color: #10b981 !important;
      }
      .bg-n-brand:hover {
        background-color: #059669 !important;
      }
      .border-n-brand, .outline-n-brand, .ring-n-brand {
        border-color: #10b981 !important;
        --tw-ring-color: #10b981 !important;
      }

      /* ==========================================================================
         MEU SUPER CHAT — FUTURISTIC CLEAN LOGIN REIMAGINED (GPT 2.5 SPEC)
         ========================================================================== */
      body.msc-auth-page {
        background-color: #04080E !important;
        color: #F8FAFC !important;
        font-family: 'Geist', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
        overflow-x: hidden !important;
        min-height: 100vh !important;
        position: relative !important;
      }

      /* Ambient Futuristic Orbital & Horizon Glow Background */
      #msc-ambient-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
        background:
          radial-gradient(circle at 50% 18%, rgba(16, 185, 129, 0.14) 0%, rgba(0, 229, 179, 0.05) 32%, transparent 65%),
          radial-gradient(ellipse 90% 55% at 50% 100%, rgba(16, 185, 129, 0.22) 0%, rgba(6, 78, 59, 0.12) 45%, transparent 75%),
          #04080E;
      }
      #msc-ambient-bg .msc-orbit-1 {
        position: absolute;
        left: 50%;
        top: 52%;
        width: 980px;
        height: 980px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 1px solid rgba(16, 185, 129, 0.14);
        box-shadow: inset 0 0 80px rgba(16, 185, 129, 0.06), 0 0 60px rgba(16, 185, 129, 0.05);
      }
      #msc-ambient-bg .msc-orbit-2 {
        position: absolute;
        left: 50%;
        top: 46%;
        width: 680px;
        height: 680px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 1px solid rgba(45, 212, 191, 0.12);
        box-shadow: inset 0 0 50px rgba(0, 229, 179, 0.05);
      }
      #msc-ambient-bg .msc-horizon-arc {
        position: absolute;
        left: 50%;
        bottom: -440px;
        width: 1380px;
        height: 760px;
        transform: translateX(-50%);
        border-radius: 50%;
        border-top: 1.5px solid rgba(110, 231, 183, 0.42);
        background: radial-gradient(ellipse at 50% 0%, rgba(16, 185, 129, 0.20) 0%, rgba(4, 120, 87, 0.06) 45%, transparent 70%);
        box-shadow: 0 -20px 90px rgba(16, 185, 129, 0.28);
      }

      /* Main Auth Container Override */
      body.msc-auth-page #app,
      body.msc-auth-page #app > div {
        background: transparent !important;
        min-height: 100vh !important;
        position: relative;
        z-index: 10;
      }
      body.msc-auth-page main {
        background: transparent !important;
        min-height: 100vh !important;
        padding-top: 24px !important;
        padding-bottom: 24px !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
      }

      /* Stacked Futuristic Brand Logo + Heading */
      body.msc-auth-page main > section:first-child {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        margin-bottom: 4px !important;
      }
      body.msc-auth-page main > section:first-child img {
        height: 64px !important;
        width: auto !important;
        filter: drop-shadow(0 0 24px rgba(16, 185, 129, 0.35));
      }
      body.msc-auth-page main > section:first-child h2 {
        margin-top: 18px !important;
        font-family: 'Geist', 'Inter', sans-serif !important;
        font-size: 28px !important;
        font-weight: 700 !important;
        letter-spacing: -0.025em !important;
        color: #FFFFFF !important;
        text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
      }

      /* Elevated Dark Glassmorphism Login Card */
      body.msc-auth-page main > section:nth-of-type(2) {
        position: relative !important;
        width: calc(100% - 32px) !important;
        max-width: 440px !important;
        margin: 22px auto 0 auto !important;
        padding: 32px 32px !important;
        border-radius: 22px !important;
        background: rgba(11, 18, 30, 0.78) !important;
        border: 1px solid rgba(45, 212, 191, 0.24) !important;
        box-shadow:
          0 25px 60px -12px rgba(0, 0, 0, 0.85),
          0 0 45px -10px rgba(16, 185, 129, 0.25),
          inset 0 1px 1px rgba(255, 255, 255, 0.12) !important;
        backdrop-filter: blur(24px) !important;
        -webkit-backdrop-filter: blur(24px) !important;
      }
      /* Specular Top & Bottom Neon Highlights on Card */
      body.msc-auth-page main > section:nth-of-type(2)::before {
        content: "";
        position: absolute;
        top: -1px;
        left: 15%;
        right: 15%;
        height: 1.5px;
        background: linear-gradient(90deg, transparent, rgba(45, 212, 191, 0.95), rgba(212, 255, 0, 0.75), transparent);
        box-shadow: 0 0 16px 2px rgba(16, 185, 129, 0.55);
        pointer-events: none;
      }
      body.msc-auth-page main > section:nth-of-type(2)::after {
        content: "";
        position: absolute;
        bottom: -1px;
        left: 20%;
        right: 20%;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.95), rgba(212, 255, 0, 0.8), transparent);
        box-shadow: 0 0 24px 4px rgba(16, 185, 129, 0.65);
        pointer-events: none;
      }

      /* Hide SSO Login Button & "OU" Divider (Email & Password Only) */
      body.msc-auth-page a[href*="/login/sso"],
      body.msc-auth-page .section-separator,
      body.msc-auth-page main > section:nth-of-type(2) > div:has(a[href*="/login/sso"]) {
        display: none !important;
      }

      /* Form Labels */
      body.msc-auth-page form label {
        color: #E2E8F0 !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        margin-bottom: 6px !important;
      }

      /* Dark Glass Inputs (Email & Password) + Autofill Override */
      body.msc-auth-page input[data-testid="email_input"],
      body.msc-auth-page input[data-testid="password_input"],
      body.msc-auth-page form input[type="text"],
      body.msc-auth-page form input[type="email"],
      body.msc-auth-page form input[type="password"] {
        height: 46px !important;
        padding-left: 42px !important;
        padding-right: 40px !important;
        border-radius: 12px !important;
        background-color: rgba(16, 25, 41, 0.88) !important;
        border: 1px solid rgba(255, 255, 255, 0.11) !important;
        outline: none !important;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35) !important;
        color: #F8FAFC !important;
        font-size: 14px !important;
        transition: all 0.2s ease !important;
      }
      body.msc-auth-page input[data-testid="email_input"]::placeholder,
      body.msc-auth-page input[data-testid="password_input"]::placeholder {
        color: #64748B !important;
      }
      body.msc-auth-page input[data-testid="email_input"]:focus,
      body.msc-auth-page input[data-testid="password_input"]:focus {
        background-color: rgba(19, 31, 51, 0.95) !important;
        border-color: #10B981 !important;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.20), inset 0 1px 2px rgba(0, 0, 0, 0.3) !important;
      }
      body.msc-auth-page input:-webkit-autofill,
      body.msc-auth-page input:-webkit-autofill:hover,
      body.msc-auth-page input:-webkit-autofill:focus {
        -webkit-text-fill-color: #F8FAFC !important;
        -webkit-box-shadow: 0 0 0px 1000px #101929 inset !important;
        border: 1px solid rgba(45, 212, 191, 0.35) !important;
        transition: background-color 5000s ease-in-out 0s;
      }

      /* Left Field Icons inside Inputs */
      .msc-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 17px;
        height: 17px;
        color: #94A3B8;
        pointer-events: none;
        z-index: 5;
      }

      /* Forgot Password Link ("Esqueceu-se da sua senha?") */
      body.msc-auth-page a[href*="reset/password"] {
        color: #00E5B3 !important;
        font-size: 12px !important;
        font-weight: 500 !important;
        text-decoration: underline !important;
        text-underline-offset: 4px !important;
        text-decoration-color: rgba(0, 229, 179, 0.45) !important;
        transition: color 0.2s ease !important;
      }
      body.msc-auth-page a[href*="reset/password"]:hover {
        color: #D4FF00 !important;
        text-decoration-color: #D4FF00 !important;
      }
      .msc-forgot-wrap {
        display: flex;
        justify-content: flex-end;
        margin-top: 8px !important;
      }

      /* Primary Submit Button ("Entrar ->") */
      body.msc-auth-page button[data-testid="submit_button"] {
        height: 48px !important;
        border-radius: 12px !important;
        background: linear-gradient(90deg, #00D68F 0%, #4ADE80 52%, #D4FF00 100%) !important;
        color: #04120B !important;
        font-family: 'Geist', 'Inter', sans-serif !important;
        font-size: 16px !important;
        font-weight: 700 !important;
        letter-spacing: -0.01em !important;
        border: none !important;
        outline: none !important;
        box-shadow: 0 0 28px rgba(16, 185, 129, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.35) !important;
        transition: all 0.2s ease !important;
      }
      body.msc-auth-page button[data-testid="submit_button"]:hover {
        filter: brightness(1.08) !important;
        box-shadow: 0 0 36px rgba(212, 255, 0, 0.48) !important;
        transform: translateY(-1px);
      }
      body.msc-auth-page button[data-testid="submit_button"] span {
        color: #04120B !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
      }
      body.msc-auth-page button[data-testid="submit_button"] span::after {
        content: "→";
        font-size: 18px;
        line-height: 1;
        font-weight: 700;
        transition: transform 0.2s ease;
      }
      body.msc-auth-page button[data-testid="submit_button"]:hover span::after {
        transform: translateX(3px);
      }

      /* Responsive Adjustments (Tablet & Mobile) */
      @media (max-width: 480px) {
        body.msc-auth-page main > section:first-child h2 {
          font-size: 22px !important;
        }
        body.msc-auth-page main > section:nth-of-type(2) {
          padding: 24px 20px !important;
        }
      }

      /* ==========================================================================
         MEU SUPER CHAT — DASHBOARD DARK GLASSMORPHISM (GPT 2.5 SPEC)
         Escopo: body.dark.msc-app-page (todas as telas logadas). Menu real preservado.
         ========================================================================== */
      body.dark.msc-app-page,
      body.dark.msc-app-page #app > div.bg-n-background,
      body.dark.msc-app-page main,
      body.dark.msc-app-page main.bg-n-surface-1 {
        background-color: #04080E !important;
      }

      /* Let immediate page wrappers inside main be transparent so main's #04080E + radial glow shines through on EVERY page */
      body.dark.msc-app-page main > div.bg-n-surface-1,
      body.dark.msc-app-page main > section.bg-n-surface-1,
      body.dark.msc-app-page main > div.bg-n-background,
      body.dark.msc-app-page main > div > section.bg-n-surface-1,
      body.dark.msc-app-page main > section > div.bg-n-surface-1:not(.conversations-list-wrap):not(.conversation-details-wrap),
      body.dark.msc-app-page main > div > div > div.bg-n-solid-1.justify-center {
        background-color: transparent !important;
      }

      /* Global ambient emerald-lime radial glow on main workspace across all pages */
      body.dark.msc-app-page main {
        position: relative !important;
        background-color: #04080E !important;
        background-image:
          radial-gradient(ellipse 680px 380px at 88% 6%, rgba(16, 185, 129, 0.15) 0%, rgba(212, 255, 0, 0.04) 42%, transparent 72%),
          radial-gradient(ellipse 540px 340px at 18% 96%, rgba(16, 185, 129, 0.08) 0%, transparent 70%) !important;
      }

      /* Global 2nd-column lists (Caixa de Entrada / Notificações, Chat Interno, etc.) matching Conversations list */
      body.dark.msc-app-page main > section > div.lg\:min-w-\[340px\],
      body.dark.msc-app-page main > div > div.bg-n-solid-2.border-r {
        background: rgba(7, 14, 23, 0.92) !important;
        border-right: 1px solid rgba(255, 255, 255, 0.07) !important;
      }

      /* Sticky headers in inner pages (Shopify, Contacts, Reports, Settings, Portals) */
      body.dark.msc-app-page main header.bg-n-surface-1,
      body.dark.msc-app-page main header.bg-n-background {
        background: rgba(4, 8, 14, 0.85) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        border-bottom-color: rgba(255, 255, 255, 0.07) !important;
      }

      /* Cards, panels, modals & containers across all pages (Settings, Kanban, Reports, Inboxes, Internal Chat) */
      body.dark.msc-app-page main .bg-n-solid-1:not(aside),
      body.dark.msc-app-page main .bg-n-card {
        background-color: rgba(11, 22, 34, 0.62) !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
      }
      body.dark.msc-app-page main .bg-n-solid-2:not(.border-r) {
        background-color: rgba(13, 25, 40, 0.72) !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
      }

      /* Form Inputs, Selects & Textareas across Settings, Contacts, Inboxes, etc. */
      body.dark.msc-app-page main input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
      body.dark.msc-app-page main select,
      body.dark.msc-app-page main textarea {
        background-color: rgba(7, 14, 23, 0.78) !important;
        outline-color: rgba(255, 255, 255, 0.09) !important;
        border-color: rgba(255, 255, 255, 0.09) !important;
        color: #F8FAFC !important;
      }
      body.dark.msc-app-page main input:not([type="checkbox"]):not([type="radio"]):hover,
      body.dark.msc-app-page main select:hover,
      body.dark.msc-app-page main textarea:hover {
        outline-color: rgba(16, 185, 129, 0.35) !important;
      }
      body.dark.msc-app-page main input:not([type="checkbox"]):not([type="radio"]):focus,
      body.dark.msc-app-page main select:focus,
      body.dark.msc-app-page main textarea:focus {
        outline-color: #10B981 !important;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.14) !important;
      }

