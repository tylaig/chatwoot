    <script id="msc-inbox-search-refactor-v1-script">
      (function() {
        var isSyncing = false;
        var rafPending = false;

        function syncInboxAndSearch() {
          if (isSyncing) return;
          isSyncing = true;
          try {
            var path = window.location.pathname || '';
            var isInboxView = /\/app\/accounts\/\d+\/inbox-view/.test(path);
            var isSearch = /\/app\/accounts\/\d+\/search/.test(path);

            if (document.body.classList.contains('msc-inbox-view-page') !== isInboxView) {
              document.body.classList.toggle('msc-inbox-view-page', isInboxView);
            }
            if (document.body.classList.contains('msc-search-page') !== isSearch) {
              document.body.classList.toggle('msc-search-page', isSearch);
            }

            if (isInboxView) {
              var leftCol = document.querySelector('main > section > div:first-child');
              if (leftCol && leftCol.children.length >= 2) {
                var count = leftCol.querySelectorAll('.inbox-card').length;
                var strip = document.getElementById('msc-inbox-summary-strip');
                if (!strip) {
                  strip = document.createElement('div');
                  strip.id = 'msc-inbox-summary-strip';
                  strip.innerHTML = '<span><span class="msc-is-dot"></span>Alertas em tempo real</span><span class="msc-is-count">' + count + ' ativos</span>';
                  leftCol.insertBefore(strip, leftCol.children[1]);
                } else {
                  var cSpan = strip.querySelector('.msc-is-count');
                  var expected = count + ' ativos';
                  if (cSpan && cSpan.textContent !== expected) {
                    cSpan.textContent = expected;
                  }
                }
              }
            } else {
              var oldStrip = document.getElementById('msc-inbox-summary-strip');
              if (oldStrip) oldStrip.remove();
            }

            if (isSearch) {
              var searchWrap = document.querySelector('main .max-w-5xl > .flex.flex-col.w-full.px-4');
              if (searchWrap && !document.getElementById('msc-search-hero')) {
                var hero = document.createElement('div');
                hero.id = 'msc-search-hero';
                hero.innerHTML =
                  '<div class="msc-sh-left">' +
                    '<div class="msc-sh-badge">' +
                      '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>' +
                    '</div>' +
                    '<div>' +
                      '<h2>Busca Global Omnichannel</h2>' +
                      '<p>Pesquise instantaneamente em Contatos, Conversas, Mensagens e Artigos da Central de Ajuda</p>' +
                    '</div>' +
                  '</div>' +
                  '<span class="msc-sh-kbd">Atalho: / para focar</span>';
                searchWrap.insertBefore(hero, searchWrap.firstChild);
              }

              document.querySelectorAll('main h3').forEach(function(h3) {
                if ((h3.textContent || '').trim() === 'Messagem') {
                  h3.textContent = 'Mensagens';
                }
