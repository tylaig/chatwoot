      /* ==========================================================================
         10. MEUSUPER.APP DESIGN SYSTEM — GEIST TYPOGRAPHY, ANIMATIONS & LOADERS
             Matches https://meusuper.app/ visual identity, fonts & motion
         ========================================================================== */
      :root, html, body {
        --font-lp-sans: Geist, Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif !important;
        --font-lp-mono: Geist Mono, JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, monospace !important;
        --font-sans: Geist, Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif !important;
        --font-inter: Geist, Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif !important;
      }

      html, body, #app, button, input, select, textarea {
        font-family: var(--font-lp-sans) !important;
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
        text-rendering: optimizeLegibility !important;
        font-feature-settings: "ss01", "cv11" !important;
      }

      /* Headings with tight geometric tracking like meusuper.app */
      h1, h2, h3, h4, .font-semibold, .font-bold {
        font-family: var(--font-lp-sans) !important;
        letter-spacing: -0.028em !important;
      }

      code, pre, kbd, .font-mono {
        font-family: var(--font-lp-mono) !important;
      }

      body.dark ::selection {
        background: rgba(16, 185, 129, 0.30) !important;
        color: #ECFDF5 !important;
      }
      body:not(.dark) ::selection {
        background: rgba(16, 185, 129, 0.22) !important;
        color: #064E3B !important;
      }

      /* Subtle Architectural Grid + Emerald Radial Spotlight on Main Views */
      body.dark.msc-app-page main,
      body.dark.msc-app-page .msc-kanban-root,
      body.dark.msc-app-page .conversation-details-wrap {
        background-color: #060A11 !important;
        background-image:
          radial-gradient(ellipse 75% 50% at 50% 0%, rgba(16, 185, 129, 0.095) 0%, transparent 70%),
          linear-gradient(rgba(255, 255, 255, 0.026) 1px, transparent 0),
          linear-gradient(90deg, rgba(255, 255, 255, 0.026) 1px, transparent 0) !important;
        background-size: 100% 100%, 64px 64px, 64px 64px !important;
      }

      /* Keyframes from meusuper.app */
      @keyframes msc-lp-pop {
        0% {
          opacity: 0;
          transform: translate3d(0, 10px, 0) scale(0.985);
        }
        100% {
          opacity: 1;
          transform: translate3d(0, 0, 0) scale(1);
        }
      }

      @keyframes msc-lp-shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(220%); }
      }

      @keyframes msc-top-bar {
        0% { transform: translateX(-100%) scaleX(0.2); opacity: 1; }
        50% { transform: translateX(0%) scaleX(0.65); opacity: 1; }
        100% { transform: translateX(100%) scaleX(1); opacity: 0; }
      }

      @keyframes msc-pulse-dot {
        0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.55); }
        50% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      }

      /* Top Emerald Route Progress Bar */
      #msc-top-loader {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2.5px;
        z-index: 99999;
        pointer-events: none;
        overflow: hidden;
        opacity: 0;
        transition: opacity 0.25s ease;
      }
      #msc-top-loader.is-active {
        opacity: 1;
      }
      #msc-top-loader::after {
        content: "";
        display: block;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, #10B981, #34D399, #D4FF00, transparent);
        box-shadow: 0 0 16px rgba(16, 185, 129, 0.85);
        animation: msc-top-bar 0.85s cubic-bezier(0.16, 1, 0.3, 1) infinite;
      }

      /* Smooth Entrance Reveal on Kanban Columns, Cards, Conversation Items & Messages */
      body.dark.msc-app-page .msc-kanban-root article,
