<% if @article.present? %>
<script>
  (function() {
    let viewTracked = false;
    const trackView = function() {
      if (!viewTracked) {
        viewTracked = true;
        const img = new Image();
        img.src = '<%= request.base_url %>/hc/<%= @portal.slug %>/articles/<%= @article.slug %>.png';
      }
    };

    const addTrackingListeners = function() {
      const events = ['mouseenter', 'touchstart', 'focus'];
      events.forEach(event => {
        document.body.addEventListener(event, function() {
          setTimeout(trackView, 5000);
        }, { once: true });
      });
    };
    addTrackingListeners();
  })();
</script>
<% end %>
<style id="msc-hc-obsidian-theme">
  html.dark {
    --dynamic-portal-bg: #04090D;
    --dynamic-portal-bg-gradient: radial-gradient(circle at 20% 20%, rgba(16, 185, 129, 0.16), transparent 55%), linear-gradient(180deg, #061018 0%, #04090D 100%);
    --dynamic-hover-bg-color: rgba(16, 185, 129, 0.12);
    --dynamic-portal-color: #10B981;
    --dynamic-portal-color-soft: rgba(16, 185, 129, 0.16);
    --dynamic-portal-color-faint: rgba(16, 185, 129, 0.07);
    color-scheme: dark;
  }

  html.light, html:not(.dark) {
    --dynamic-portal-bg: #F4F9F7;
    --dynamic-portal-bg-gradient: radial-gradient(circle at 20% 20%, rgba(16, 185, 129, 0.12), transparent 55%), linear-gradient(180deg, #ECFDF5 0%, #F8FAFC 100%);
    --dynamic-hover-bg-color: rgba(16, 185, 129, 0.08);
    --dynamic-portal-color: #059669;
    --dynamic-portal-color-soft: rgba(16, 185, 129, 0.12);
    --dynamic-portal-color-faint: rgba(16, 185, 129, 0.05);
    color-scheme: light;
  }

  /* Base surfaces */
  html.dark body {
    background-color: #04090D !important;
    color: #F1F5F9 !important;
  }
  html:not(.dark) body {
    background-color: #F8FAFC !important;
    color: #0F172A !important;
  }

  html.dark .bg-white.dark\:bg-n-slate-2,
  html.dark main.main-content > div {
    background-color: #04090D !important;
  }
  html:not(.dark) .bg-white.dark\:bg-n-slate-2,
  html:not(.dark) main.main-content > div {
    background-color: #F8FAFC !important;
  }

  /* Topbar */
  html.dark header.sticky.top-0 {
    background: rgba(6, 14, 21, 0.92) !important;
    backdrop-filter: blur(14px) !important;
    border-bottom: 1px solid #132836 !important;
  }
  html:not(.dark) header.sticky.top-0 {
    background: rgba(255, 255, 255, 0.92) !important;
    backdrop-filter: blur(14px) !important;
    border-bottom: 1px solid rgba(16, 185, 129, 0.18) !important;
  }

  /* Sidebar */
  html.dark aside.fixed.md\:sticky {
    background: #061018 !important;
    border-right-color: #132836 !important;
  }
  html:not(.dark) aside.fixed.md\:sticky {
    background: #FFFFFF !important;
    border-right-color: rgba(16, 185, 129, 0.16) !important;
  }

  /* Hero section */
  html.dark section.min-h-\[50vh\] {
    background: radial-gradient(circle at 18% 25%, rgba(16, 185, 129, 0.16), transparent 48%),
                radial-gradient(circle at 82% 15%, rgba(198, 255, 0, 0.07), transparent 40%),
                linear-gradient(180deg, #07131D 0%, #04090D 100%) !important;
    border-bottom: 1px solid #132836 !important;
    min-height: 340px !important;
  }
  html:not(.dark) section.min-h-\[50vh\] {
    background: radial-gradient(circle at 18% 25%, rgba(16, 185, 129, 0.14), transparent 50%),
                linear-gradient(180deg, #ECFDF5 0%, #FFFFFF 100%) !important;
    border-bottom: 1px solid rgba(16, 185, 129, 0.18) !important;
    min-height: 340px !important;
  }

  /* Hero Recommended Topic Pills */
  html.dark section.min-h-\[50vh\] a.rounded-full {
    background: rgba(8, 22, 33, 0.85) !important;
    border-color: rgba(16, 185, 129, 0.35) !important;
    color: #E2E8F0 !important;
  }
  html.dark section.min-h-\[50vh\] a.rounded-full:hover {
    background: rgba(16, 185, 129, 0.18) !important;
    border-color: #10B981 !important;
    color: #34D399 !important;
  }
  html:not(.dark) section.min-h-\[50vh\] a.rounded-full {
    background: #FFFFFF !important;
    border-color: rgba(16, 185, 129, 0.28) !important;
    color: #0F172A !important;
  }
  html:not(.dark) section.min-h-\[50vh\] a.rounded-full:hover {
    background: rgba(16, 185, 129, 0.10) !important;
    border-color: #059669 !important;
    color: #047857 !important;
  }

  /* Category & Article Cards */
  html.dark a.group.rounded-xl.border {
    background: linear-gradient(180deg, #091622 0%, #07111A 100%) !important;
    border-color: #152C3A !important;
    box-shadow: 0 14px 32px -18px rgba(0, 0, 0, 0.65) !important;
    position: relative;
    overflow: hidden;
  }
  html:not(.dark) a.group.rounded-xl.border {
    background: #FFFFFF !important;
    border-color: rgba(16, 185, 129, 0.20) !important;
    box-shadow: 0 12px 28px -18px rgba(15, 23, 42, 0.10) !important;
    position: relative;
    overflow: hidden;
  }
  a.group.rounded-xl.border::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, #10B981 0%, #C6FF00 100%);
  }
  a.group.rounded-xl.border:hover {
    border-color: #10B981 !important;
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -16px rgba(16, 185, 129, 0.28) !important;
  }

  /* Search inputs */
  html.dark #search-wrap input,
  html.dark #search-wrap-hero input,
  html.dark #search-wrap button,
  html.dark #search-wrap-hero button {
    background-color: #081520 !important;
    border-color: #193546 !important;
    color: #F1F5F9 !important;
  }
  html:not(.dark) #search-wrap input,
  html:not(.dark) #search-wrap-hero input {
    background-color: #FFFFFF !important;
    border-color: rgba(16, 185, 129, 0.28) !important;
  }

  /* Article Prose Code & Headings */
  html.dark article .prose code {
    background: rgba(16, 185, 129, 0.14) !important;
    color: #6EE7B7 !important;
    padding: 2px 6px !important;
    border-radius: 6px !important;
    border: 1px solid rgba(16, 185, 129, 0.28) !important;
  }
  html:not(.dark) article .prose code {
    background: rgba(16, 185, 129, 0.10) !important;
    color: #047857 !important;
    padding: 2px 6px !important;
    border-radius: 6px !important;
    border: 1px solid rgba(16, 185, 129, 0.24) !important;
  }

  /* Custom Brand Mark & Header Controls */
  .msc-hc-brand-badge {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, #10B981 0%, #059669 75%, #C6FF00 100%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #03120D;
    font-weight: 900;
    font-size: 16px;
    box-shadow: 0 8px 20px -8px rgba(16, 185, 129, 0.65);
    flex-shrink: 0;
  }
  .msc-hc-hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #059669;
  }
  html.dark .msc-hc-hero-kicker {
    color: #34D399;
    background: rgba(16, 185, 129, 0.16);
    border-color: rgba(16, 185, 129, 0.40);
  }
  .msc-hc-hero-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #C6FF00;
    box-shadow: 0 0 8px #10B981;
  }
  .msc-hc-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    border-radius: 9px;
    font-size: 12.5px;
    font-weight: 700;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: #03120D !important;
    text-decoration: none;
    box-shadow: 0 8px 18px -8px rgba(16, 185, 129, 0.6);
    transition: all 0.16s ease;
    white-space: nowrap;
  }
  .msc-hc-wa-btn:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }
</style>

<script>
  window.portalConfig = {
    portalSlug: '<%= @portal.slug %>',
    portalColor: '<%= @portal.color %>',
    theme: '<%= @theme_from_params %>',
    customDomain: '<%= @portal.custom_domain %>',
    hostURL: '<%= ENV.fetch('FRONTEND_URL', '') %>',
    localeCode: '<%= @locale %>',
    searchTranslations: {
      searchPlaceholder: '<%= I18n.t('public_portal.search.search_placeholder') %>',
      emptyPlaceholder: '<%= I18n.t('public_portal.search.empty_placeholder') %>',
      loadingPlaceholder: '<%= I18n.t('public_portal.search.loading_placeholder') %>',
      resultsTitle: '<%= I18n.t('public_portal.search.results_title') %>',
      submit: '<%= I18n.t('public_portal.search.submit') %>',
    },
    isPlainLayoutEnabled: '<%= @is_plain_layout_enabled %>',
    tocHeader: '<%= I18n.t('public_portal.toc_header') %>'
  };
</script>
<% if !@is_plain_layout_enabled && @portal.custom_body_html.present? %>
  <%= @portal.custom_body_html.html_safe %>
<% end %>
